From: Julius Bairaktaris <julius@bairaktaris.de>
Subject: [PATCH] wifi: mac80211: hand GRO batches to a driver that sends them

A forwarded TCP flow arrives as fraglist GRO batches, and the TCP GSO
code splits such a batch whatever the features passed to it. On the
802.3 path mac80211 therefore queued, scheduled and completed every
frame of a batch on its own even when the driver could send the batch
whole. Leave a GSO frame intact on the 802.3 path when the interface
features cover it, and allow NETIF_F_FRAGLIST and NETIF_F_GSO_FRAGLIST
among the driver's features so that a fraglist batch can be covered. The frame counters
count the frames of a batch.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
---
--- a/net/mac80211/ieee80211_i.h
+++ b/net/mac80211/ieee80211_i.h
@@ -2185,6 +2185,7 @@ void ieee80211_color_collision_detection
 #define MAC80211_SUPPORTED_FEATURES_TX	(NETIF_F_IP_CSUM | NETIF_F_IPV6_CSUM | \
 					 NETIF_F_HW_CSUM | NETIF_F_SG | \
 					 NETIF_F_HIGHDMA | NETIF_F_GSO_SOFTWARE | \
+					 NETIF_F_FRAGLIST | NETIF_F_GSO_FRAGLIST | \
 					 NETIF_F_HW_TC)
 #define MAC80211_SUPPORTED_FEATURES_RX	(NETIF_F_RXCSUM)
 #define MAC80211_SUPPORTED_FEATURES	(MAC80211_SUPPORTED_FEATURES_TX | \
--- a/net/mac80211/tx.c
+++ b/net/mac80211/tx.c
@@ -4720,6 +4720,7 @@ static void ieee80211_8023_xmit(struct i
 	struct ieee80211_chanctx_conf *chanctx_conf;
 	struct tid_ampdu_tx *tid_tx = NULL;
 	struct sk_buff *seg, *next;
+	netdev_features_t features;
 	unsigned int skbs = 0, len = 0;
 	u16 queue;
 	u8 tid;
@@ -4754,9 +4755,12 @@ static void ieee80211_8023_xmit(struct i
 			tid_tx->last_tx = jiffies;
 	}
 
-	skb = ieee80211_tx_skb_fixup(skb, ieee80211_sdata_netdev_features(sdata));
-	if (!skb)
-		return;
+	features = ieee80211_sdata_netdev_features(sdata);
+	if (!skb_is_gso(skb) || !skb_gso_ok(skb, features)) {
+		skb = ieee80211_tx_skb_fixup(skb, features);
+		if (!skb)
+			return;
+	}
 
 	info = IEEE80211_SKB_CB(skb);
 	memset(info, 0, sizeof(*info));
@@ -4784,7 +4788,7 @@ static void ieee80211_8023_xmit(struct i
 		info->control.hw_key = &key->conf;
 
 	skb_list_walk_safe(skb, seg, next) {
-		skbs++;
+		skbs += skb_is_gso(seg) ? skb_shinfo(seg)->gso_segs : 1;
 		len += seg->len;
 		if (seg != skb)
 			memcpy(IEEE80211_SKB_CB(seg), info, sizeof(*info));
