+static ssize_t ieee80211_if_fmt_zero_touch(
+	const struct ieee80211_sub_if_data *sdata, char *buf, int buflen)
+{
+	return scnprintf(buf, buflen, "%d\n", sdata->vif.zero_touch);
+}
+
+/* The XDP features change under the RTNL, which nests outside the wiphy lock
+ * and is held while the file is removed.
+ */
+static ssize_t ieee80211_if_write_zero_touch(struct file *file,
+					     const char __user *userbuf,
+					     size_t count, loff_t *ppos)
+{
+	struct ieee80211_sub_if_data *sdata = file->private_data;
+	bool on;
+	int ret;
+
+	ret = kstrtobool_from_user(userbuf, count, &on);
+	if (ret)
+		return ret;
+
+	if (!rtnl_trylock())
+		return restart_syscall();
+	wiphy_lock(sdata->local->hw.wiphy);
+	ieee80211_set_zero_touch(sdata, on);
+	wiphy_unlock(sdata->local->hw.wiphy);
+	rtnl_unlock();
+
+	return count;
+}
+_IEEE80211_IF_FILE_R_FN(zero_touch)
+_IEEE80211_IF_FILE_OPS(zero_touch, ieee80211_if_read_zero_touch,
+		       ieee80211_if_write_zero_touch);
