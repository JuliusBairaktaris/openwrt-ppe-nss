 };
 
 static bool ieee80211_iftype_supports_hdr_offload(enum nl80211_iftype iftype)
@@ -1169,6 +1191,41 @@ static void ieee80211_recalc_sdata_offlo
 	}
 }
 
+/* The driver decides on the encapsulation from zero_touch, so it is asked
+ * again even when mac80211's own offload flags stay the same.
+ */
+void ieee80211_set_zero_touch(struct ieee80211_sub_if_data *sdata, bool on)
+{
+	struct ieee80211_local *local = sdata->local;
+	struct ieee80211_sub_if_data *vsdata;
+
+	ASSERT_RTNL();
+	lockdep_assert_wiphy(local->hw.wiphy);
+
+	if (sdata->vif.zero_touch == on)
+		return;
+	WRITE_ONCE(sdata->vif.zero_touch, on);
+
+	if (on && local->ops->xdp_xmit)
+		xdp_features_set_redirect_target(sdata->dev, false);
+	else
+		xdp_features_clear_redirect_target(sdata->dev);
+
+	if (!ieee80211_sdata_running(sdata) ||
+	    !ieee80211_hw_check(&local->hw, SUPPORTS_TX_ENCAP_OFFLOAD))
+		return;
+
+	ieee80211_set_sdata_offload_flags(sdata);
+	drv_update_vif_offload(local, sdata);
+	ieee80211_check_fast_rx_iface(sdata);
+	ieee80211_set_vif_encap_ops(sdata);
+
+	list_for_each_entry(vsdata, &local->interfaces, list)
+		if (vsdata->vif.type == NL80211_IFTYPE_AP_VLAN &&
+		    vsdata->bss == &sdata->u.ap)
+			ieee80211_set_vif_encap_ops(vsdata);
+}
