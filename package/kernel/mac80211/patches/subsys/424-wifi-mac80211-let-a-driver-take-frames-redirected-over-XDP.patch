+/* Frames redirected from another device skip the TXQs, so they are taken only
+ * on an interface the user opted in. They are Ethernet frames, which the
+ * driver sends only while it does the encapsulation.
+ */
+static int ieee80211_xdp_xmit(struct net_device *dev, int n,
+			      struct xdp_frame **frames, u32 flags)
+{
+	struct ieee80211_sub_if_data *sdata = IEEE80211_DEV_TO_SUB_IF(dev);
+	struct ieee80211_local *local = sdata->local;
+
+	if (!local->ops->xdp_xmit || !READ_ONCE(sdata->vif.zero_touch) ||
+	    sdata->vif.type != NL80211_IFTYPE_AP ||
+	    !(sdata->vif.offload_flags & IEEE80211_OFFLOAD_ENCAP_ENABLED) ||
+	    !ieee80211_sdata_running(sdata))
+		return 0;
+
+	return local->ops->xdp_xmit(&local->hw, &sdata->vif, n, frames, flags);
+}
+
