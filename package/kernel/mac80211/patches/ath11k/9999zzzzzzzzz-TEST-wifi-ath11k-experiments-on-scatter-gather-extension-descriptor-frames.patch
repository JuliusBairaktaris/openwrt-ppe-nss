+
+static void ath11k_dp_tx_ext_buf(struct hal_tx_msdu_ext *ext, unsigned int k,
+				 dma_addr_t dma, unsigned int len)
+{
+	ext->buf[k].addr_lo = lower_32_bits(dma);
+	ext->buf[k].info = FIELD_PREP(HAL_TX_MSDU_EXT_BUF_INFO_ADDR_HI,
+				      upper_32_bits(dma)) |
+			   FIELD_PREP(HAL_TX_MSDU_EXT_BUF_INFO_LEN, len);
+}
+
+/* TEST: the buffers of a frame with fragments as the vendor's multicast
+ * enhancement lays out a frame it converts to unicast (wifi-host-cmn
+ * dp/wifi3.0/dp_txrx_me.c:562-615): the destination address copied to a
+ * buffer of its own, mapped by itself, then the rest of the linear part
+ * from the mapping of the linear part, then the fragments. @da is the
+ * address buffer of the descriptor; the map lists the address and the
+ * fragments, which are unmapped with it.
+ */
+static int ath11k_dp_tx_ext_map_split_da(struct device *dev,
+					 struct sk_buff *skb,
+					 struct ath11k_dp_tx_ext_map *map,
+					 struct hal_tx_msdu_ext *ext, u8 *da,
+					 dma_addr_t hdr_dma,
+					 unsigned int hdr_len)
+{
+	struct skb_shared_info *shinfo = skb_shinfo(skb);
+	dma_addr_t dma;
+	unsigned int k;
+
+	map->num = 0;
+	memcpy(da, skb->data, ETH_ALEN);
+	/* as a page, as ath11k_dp_tx_tso_unmap() unmaps it */
+	dma = dma_map_page(dev, virt_to_page(da), offset_in_page(da), ETH_ALEN,
+			   DMA_TO_DEVICE);
+	if (dma_mapping_error(dev, dma))
+		return -ENOMEM;
+	map->dma[0] = dma;
+	map->len[0] = ETH_ALEN;
+	map->num = 1;
+	ath11k_dp_tx_ext_buf(ext, 0, dma, ETH_ALEN);
+	ath11k_dp_tx_ext_buf(ext, 1, hdr_dma + ETH_ALEN, hdr_len - ETH_ALEN);
+
+	for (k = 0; k < shinfo->nr_frags; k++) {
+		skb_frag_t *frag = &shinfo->frags[k];
+
+		if (map->num == HAL_TX_MSDU_EXT_NUM_BUFS - 1)
+			return -E2BIG;
+		dma = skb_frag_dma_map(dev, frag, 0, skb_frag_size(frag),
+				       DMA_TO_DEVICE);
+		if (dma_mapping_error(dev, dma))
+			return -ENOMEM;
+		map->dma[map->num] = dma;
+		map->len[map->num] = skb_frag_size(frag);
+		map->num++;
+		ath11k_dp_tx_ext_buf(ext, k + 2, dma, skb_frag_size(frag));
+	}
+
+	return 0;
 }
 
