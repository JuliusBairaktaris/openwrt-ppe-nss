 #define ATH11K_EXT_LOG_MAX	8
 
+/* TEST-ONLY: how many of the next frames sent through extension descriptors,
+ * of any station, are logged. Writing it arms that many again, so that each
+ * run of a test logs its own frames; reading it gives how many are left.
+ */
+static atomic_t ath11k_ext_log_left = ATOMIC_INIT(ATH11K_EXT_LOG_MAX);
+static atomic_t ath11k_ext_log_seq;
+
+static int ath11k_ext_log_first_set(const char *val,
+				    const struct kernel_param *kp)
+{
+	unsigned int n;
+	int ret;
+
+	ret = kstrtouint(val, 0, &n);
+	if (ret)
+		return ret;
+	if (n > INT_MAX)
+		return -EINVAL;
+
+	atomic_set(&ath11k_ext_log_left, n);
+	return 0;
+}
+
+static int ath11k_ext_log_first_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%d\n", atomic_read(&ath11k_ext_log_left));
+}
+
+static const struct kernel_param_ops ath11k_ext_log_first_ops = {
+	.set = ath11k_ext_log_first_set,
+	.get = ath11k_ext_log_first_get,
+};
+
+module_param_cb(ext_log_first, &ath11k_ext_log_first_ops, NULL, 0644);
+__MODULE_PARM_TYPE(ext_log_first, "uint");
+MODULE_PARM_DESC(ext_log_first,
+		 "Log the next N frames sent through extension descriptors; a write arms N again (default: 8)");
