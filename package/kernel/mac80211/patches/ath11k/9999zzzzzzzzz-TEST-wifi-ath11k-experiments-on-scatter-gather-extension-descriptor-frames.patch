+/* TEST-ONLY: other layouts of a frame sent through an extension descriptor,
+ * for the experiments on the frames the TCL takes and never transmits. They
+ * apply to frames with fragments, ext_one_buf to linear frames; all to plain
+ * IPv4 or IPv6 TCP frames to a station, with tso set. With several set, the
+ * first here wins; a frame the chosen one cannot take is sent the normal
+ * way. Read for each frame.
+ */
+static bool ath11k_ext_sg_swcsum;
+module_param_named(ext_sg_swcsum, ath11k_ext_sg_swcsum, bool, 0644);
+MODULE_PARM_DESC(ext_sg_swcsum,
+		 "Frames with fragments: checksum in software, no TCL checksum enables (default: off)");
+
+static bool ath11k_ext_sg_as_tso;
+module_param_named(ext_sg_as_tso, ath11k_ext_sg_as_tso, bool, 0644);
+MODULE_PARM_DESC(ext_sg_as_tso,
+		 "Frames with fragments: sent as a TSO batch of one segment (default: off)");
+
+static bool ath11k_ext_sg_split_da;
+module_param_named(ext_sg_split_da, ath11k_ext_sg_split_da, bool, 0644);
+MODULE_PARM_DESC(ext_sg_split_da,
+		 "Frames with fragments: destination address in a buffer of its own, checksum in software, no TCL checksum enables (default: off)");
+
+static bool ath11k_ext_one_buf;
+module_param_named(ext_one_buf, ath11k_ext_one_buf, bool, 0644);
+MODULE_PARM_DESC(ext_one_buf,
+		 "Linear frames: sent through an extension descriptor of one buffer, checksum in software, no TCL checksum enables (default: off)");
+
+enum ath11k_ext_kind {
+	/* a TCP batch */
+	ATH11K_EXT_TSO,
+	/* a frame with fragments: the linear part, then the fragments */
+	ATH11K_EXT_SG,
+	/* as ATH11K_EXT_SG, checksum in software */
+	ATH11K_EXT_SG_SWCSUM,
+	/* the headers, the rest of the linear part and the fragments, with
+	 * the TSO fields of a batch of one segment
+	 */
+	ATH11K_EXT_SG_AS_TSO,
+	/* the destination address, the rest of the linear part and the
+	 * fragments, checksum in software
+	 */
+	ATH11K_EXT_SG_SPLIT_DA,
+	/* a linear frame in one buffer, checksum in software */
+	ATH11K_EXT_ONE_BUF,
+};
+
+static const char * const ath11k_ext_kind_name[] = {
+	[ATH11K_EXT_TSO] = "tso",
+	[ATH11K_EXT_SG] = "sg",
+	[ATH11K_EXT_SG_SWCSUM] = "sg_swcsum",
+	[ATH11K_EXT_SG_AS_TSO] = "sg_as_tso",
+	[ATH11K_EXT_SG_SPLIT_DA] = "sg_split_da",
+	[ATH11K_EXT_ONE_BUF] = "one_buf",
+};
+
+/* The kind of a frame that is not a batch, by its fragments, or -1 for one
+ * that does not take an extension descriptor: one buffer for the linear part
+ * (two for ATH11K_EXT_SG_SPLIT_DA) and one for each fragment.
+ */
+static int ath11k_dp_tx_ext_kind(unsigned int nr_frags)
+{
+	enum ath11k_ext_kind kind;
+
+	if (!nr_frags)
+		return READ_ONCE(ath11k_ext_one_buf) ? ATH11K_EXT_ONE_BUF : -1;
+
+	if (READ_ONCE(ath11k_ext_sg_swcsum))
+		kind = ATH11K_EXT_SG_SWCSUM;
+	else if (READ_ONCE(ath11k_ext_sg_as_tso))
+		kind = ATH11K_EXT_SG_AS_TSO;
+	else if (READ_ONCE(ath11k_ext_sg_split_da))
+		kind = ATH11K_EXT_SG_SPLIT_DA;
+	else
+		kind = ATH11K_EXT_SG;
+
+	if (nr_frags > HAL_TX_MSDU_EXT_NUM_BUFS -
+		       (kind == ATH11K_EXT_SG_SPLIT_DA ? 2 : 1))
+		return -1;
+
+	return kind;
+}
+
+static bool ath11k_dp_tx_ext_kind_swcsum(enum ath11k_ext_kind kind)
+{
+	return kind == ATH11K_EXT_SG_SWCSUM || kind == ATH11K_EXT_SG_SPLIT_DA ||
+	       kind == ATH11K_EXT_ONE_BUF;
+}
+
+/* The words of a TCL data ring entry: the TLV header and the command */
