 #define ATH11K_TX_COOKIE_ID(c)	(FIELD_GET(DP_TX_DESC_ID_MSDU_ID, c) & ATH11K_TX_ID_MASK)
 #define ATH11K_TX_EXT_SLOT_WIDE	136
 
+/* TEST-ONLY: the non-TSO scatter-gather use of extension descriptors is taken
+ * only for an IPv4 or IPv6 (no extension headers) TCP frame; others are made
+ * linear. Read for each frame.
+ */
+static bool ath11k_ext_sg_tcp_only = true;
+module_param_named(ext_sg_tcp_only, ath11k_ext_sg_tcp_only, bool, 0644);
+MODULE_PARM_DESC(ext_sg_tcp_only,
+		 "Scatter-gather through extension descriptors for plain TCP frames only (default: on)");
+
+/* TEST-ONLY: no extension descriptor frame to a station until the hardware
+ * has completed one frame of it on the normal path. Read for each frame.
+ */
+static bool ath11k_ext_after_compl = true;
+module_param_named(ext_after_compl, ath11k_ext_after_compl, bool, 0644);
+MODULE_PARM_DESC(ext_after_compl,
+		 "No extension descriptor frames to a station before its first normal completion (default: on)");
+
+/* TEST-ONLY: log the first frames of each station sent through extension
+ * descriptors. Read for each frame.
+ */
+static bool ath11k_ext_log_first = true;
+module_param_named(ext_log_first, ath11k_ext_log_first, bool, 0644);
+MODULE_PARM_DESC(ext_log_first,
+		 "Log the first frames of a station sent through extension descriptors (default: on)");
+
+#define ATH11K_EXT_LOG_MAX	8
+
+/* The ethertype, IP protocol and L4 ports of an Ethernet frame. Returns 0 for
+ * plain IPv4 or IPv6 TCP, 1 for a frame that is not IP, 2 for another IP
+ * protocol, a fragment, IP options past the header or an IPv6 extension header.
+ */
+static int ath11k_dp_tx_ext_l4(struct sk_buff *skb, u16 *etype, u8 *proto,
+			       u16 *sport, u16 *dport)
+{
+	struct ethhdr *eth = (struct ethhdr *)skb->data;
+	__be16 _ports[2], *ports;
+	struct ipv6hdr _ip6, *ip6;
+	struct iphdr _ip, *ip;
+	unsigned int off;
+	u8 p;
+
+	*etype = ntohs(eth->h_proto);
+	*proto = 0;
+	*sport = 0;
+	*dport = 0;
+
+	switch (*etype) {
+	case ETH_P_IP:
+		ip = skb_header_pointer(skb, ETH_HLEN, sizeof(_ip), &_ip);
+		if (!ip || ip->ihl < 5)
+			return 2;
+		p = ip->protocol;
+		off = ETH_HLEN + ip->ihl * 4;
+		if (ip->frag_off & htons(IP_OFFSET | IP_MF))
+			p = 0;
+		break;
+	case ETH_P_IPV6:
+		ip6 = skb_header_pointer(skb, ETH_HLEN, sizeof(_ip6), &_ip6);
+		if (!ip6)
+			return 2;
+		p = ip6->nexthdr;
+		off = ETH_HLEN + sizeof(_ip6);
+		break;
+	default:
+		return 1;
+	}
+
+	*proto = p;
+	if (p != IPPROTO_TCP && p != IPPROTO_UDP)
+		return 2;
+	ports = skb_header_pointer(skb, off, sizeof(_ports), _ports);
+	if (ports) {
+		*sport = ntohs(ports[0]);
+		*dport = ntohs(ports[1]);
+	}
+	return p == IPPROTO_TCP ? 0 : 2;
+}
