+				    &lg_dport);
+		lg_len = skb->len;
+		lg_frags = shinfo->nr_frags;
+		lg_segs = tso ? shinfo->gso_segs : 0;
+		dolog = true;
 	}
 
 	if (held_ring >= 0)
@@ -876,6 +994,18 @@
