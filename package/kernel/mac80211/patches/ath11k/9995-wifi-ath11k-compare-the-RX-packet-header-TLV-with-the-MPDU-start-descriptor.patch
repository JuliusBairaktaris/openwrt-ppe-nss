 		       false);
 }
 
+/* TEST-ONLY switch that compares the 802.11 header of the packet header TLV
+ * with the MPDU start descriptor, to settle on the device whether the TLV
+ * can be dropped; dropped before this is upstreamed.
+ */
+static bool ath11k_rx_hdr_check;
+module_param_named(rx_hdr_check, ath11k_rx_hdr_check, bool, 0644);
+MODULE_PARM_DESC(rx_hdr_check,
+		 "Count the differences between the packet header TLV and the MPDU start descriptor (default: off)");
+
+static void ath11k_dp_rx_h_hdr_check(struct ath11k *ar, struct sk_buff *msdu,
+				     struct hal_rx_desc *rx_desc,
+				     enum hal_encrypt_type enctype)
+{
+	struct ath11k_base *ab = ar->ab;
+	int first = ATH11K_SKB_RXCB(msdu)->is_first_msdu;
+	u32 bad;
+	int i;
+
+	if (!ab->hw_params.hw_ops->rx_desc_cmp_hdr)
+		return;
+
+	bad = ab->hw_params.hw_ops->rx_desc_cmp_hdr(rx_desc,
+						    enctype == HAL_ENCRYPT_TYPE_CCMP_128);
+	ab->soc_stats.rx_hdr_checked[first]++;
+	if (!bad)
+		return;
+
+	ab->soc_stats.rx_hdr_bad[first]++;
+	for (i = 0; i < 11; i++)
+		if (bad & BIT(i))
+			ab->soc_stats.rx_hdr_bad_field[first][i]++;
+}
