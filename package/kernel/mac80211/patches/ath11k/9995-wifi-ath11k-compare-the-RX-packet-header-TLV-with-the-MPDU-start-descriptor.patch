+/* Compare the 802.11 header and the CCMP header of the packet header TLV with
+ * what the MPDU start descriptor says: the bits of the result name the fields
+ * that differ. Bit 10: the descriptor holds no frame control.
+ */
+static u32 ath11k_hw_ipq8074_rx_desc_cmp_hdr(struct hal_rx_desc *desc, bool ccmp)
+{
+	const struct rx_mpdu_start_ipq8074 *ms = &desc->u.ipq8074.mpdu_start;
+	const struct ieee80211_hdr *h = (void *)desc->u.ipq8074.hdr_status;
+	u32 info1 = __le32_to_cpu(ms->info1);
+	u32 bad = 0;
+	size_t len;
+
+	if (!(info1 & RX_MPDU_START_INFO1_MPDU_FCTRL_VALID))
+		return BIT(10);
+
+	if (ms->frame_ctrl != h->frame_control)
+		bad |= BIT(0);
+	if ((info1 & RX_MPDU_START_INFO1_MPDU_DUR_VALID) &&
+	    ms->duration != h->duration_id)
+		bad |= BIT(1);
+	if ((info1 & RX_MPDU_START_INFO1_MAC_ADDR1_VALID) &&
+	    !ether_addr_equal(ms->addr1, h->addr1))
+		bad |= BIT(2);
+	if ((info1 & RX_MPDU_START_INFO1_MAC_ADDR2_VALID) &&
+	    !ether_addr_equal(ms->addr2, h->addr2))
+		bad |= BIT(3);
+	if ((info1 & RX_MPDU_START_INFO1_MAC_ADDR3_VALID) &&
+	    !ether_addr_equal(ms->addr3, h->addr3))
+		bad |= BIT(4);
+	if ((info1 & RX_MPDU_START_INFO1_MPDU_SEQ_CTRL_VALID) &&
+	    ms->seq_ctrl != h->seq_ctrl)
+		bad |= BIT(5);
+
+	len = ieee80211_hdrlen(h->frame_control);
+	if (len > HAL_RX_DESC_HDR_STATUS_LEN - 8)
+		return bad | BIT(10);
+
+	if (ieee80211_has_a4(h->frame_control) &&
+	    (!(info1 & RX_MPDU_START_INFO1_MAC_ADDR4_VALID) ||
+	     !ether_addr_equal(ms->addr4, h->addr4)))
+		bad |= BIT(6);
+	if (ieee80211_is_data_qos(h->frame_control) &&
+	    (!(info1 & RX_MPDU_START_INFO1_MPDU_QOS_CTRL_VALID) ||
+	     ms->qos_ctrl != *(__le16 *)ieee80211_get_qos_ctl((void *)h)))
+		bad |= BIT(7);
+	if (ieee80211_is_data_qos(h->frame_control) &&
+	    ieee80211_has_order(h->frame_control) &&
+	    (!(info1 & RX_MPDU_START_INFO1_MPDU_HT_CTRL_VALID) ||
+	     ms->ht_ctrl != get_unaligned((__le32 *)((u8 *)h + len - 4))))
+		bad |= BIT(8);
+
+	if (ccmp && ieee80211_has_protected(h->frame_control)) {
+		u32 pn0 = __le32_to_cpu(ms->pn[0]);
+		u32 pn1 = __le32_to_cpu(ms->pn[1]);
+		u8 iv[8] = { pn0, pn0 >> 8, 0,
+			     FIELD_GET(RX_MPDU_START_INFO5_KEY_ID,
+				       __le32_to_cpu(ms->info5)),
+			     pn0 >> 16, pn0 >> 24, pn1, pn1 >> 8 };
+
+		if (memcmp((u8 *)h + len, iv, sizeof(iv)))
+			bad |= BIT(9);
+	}
+
+	return bad;
+}
