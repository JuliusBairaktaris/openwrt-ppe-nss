+	/* The frames of the run are done: count them in one step for each
+	 * radio. The decrement is fully ordered and comes before the read of
+	 * the starved mark below, as the one of each frame did.
+	 */
+	for (i = 0; i < ab->num_radios; i++) {
+		if (!pending[i])
+			continue;
+		ar = ab->pdevs[i].ar;
+		if (!atomic_sub_return(pending[i], &ar->dp.num_tx_pending))
+			wake_up(&ar->dp.tx_empty_waitq);
+	}
