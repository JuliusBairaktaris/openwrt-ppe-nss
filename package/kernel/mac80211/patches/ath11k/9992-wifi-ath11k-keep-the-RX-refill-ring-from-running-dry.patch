--- a/drivers/net/wireless/ath/ath11k/dp.c
+++ b/drivers/net/wireless/ath/ath11k/dp.c
@@ -770,6 +770,33 @@ fail_desc_bank_free:
 	return ret;
 }
 
+/* The refill ring is served from the low-threshold interrupt of its group.
+ * The groups that carry it also carry the TX completion, the REO exception
+ * and the WBM error handlers, which return from the poll when they have used
+ * the budget, so under load the refill below them is never reached while the
+ * hardware drains the ring.
+ */
+static void ath11k_dp_service_rx_refill(struct ath11k_base *ab, int grp_id)
+{
+	const struct ath11k_hw_hal_params *hal_params = ab->hw_params.hal_params;
+	int i, j;
+
+	for (i = 0; i < ab->num_radios; i++) {
+		for (j = 0; j < ab->hw_params.num_rxdma_per_pdev; j++) {
+			int id = i * ab->hw_params.num_rxdma_per_pdev + j;
+			struct ath11k *ar;
+
+			if (!(ab->hw_params.ring_mask->host2rxdma[grp_id] & BIT(id)))
+				continue;
+
+			ar = ath11k_ab_to_ar(ab, id);
+			ath11k_dp_rxbufs_replenish(ab, id,
+						   &ar->dp.rx_refill_buf_ring, 0,
+						   hal_params->rx_buf_rbm);
+		}
+	}
+}
+
 int ath11k_dp_service_srng(struct ath11k_base *ab,
 			   struct ath11k_ext_irq_grp *irq_grp,
 			   int budget)
@@ -781,6 +808,9 @@ int ath11k_dp_service_srng(struct ath11k
 	int i, j;
 	int tot_work_done = 0;
 
+	if (ath11k_rx_refill_early)
+		ath11k_dp_service_rx_refill(ab, grp_id);
+
 	for (i = 0; i < ab->hw_params.hal_params->num_tx_rings; i++) {
 		if (BIT(ab->hw_params.hal_params->tcl2wbm_rbm_map[i].wbm_ring_num) &
 		    ab->hw_params.ring_mask->tx[grp_id]) {
@@ -859,7 +889,8 @@ int ath11k_dp_service_srng(struct ath11k
 			if (budget <= 0)
 				goto done;
 
-			if (ab->hw_params.ring_mask->host2rxdma[grp_id] & BIT(id)) {
+			if (!ath11k_rx_refill_early &&
+			    ab->hw_params.ring_mask->host2rxdma[grp_id] & BIT(id)) {
 				struct ath11k *ar = ath11k_ab_to_ar(ab, id);
 				struct ath11k_pdev_dp *dp = &ar->dp;
 				struct dp_rxdma_ring *rx_ring = &dp->rx_refill_buf_ring;
--- a/drivers/net/wireless/ath/ath11k/dp.h
+++ b/drivers/net/wireless/ath/ath11k/dp.h
@@ -81,6 +81,10 @@ struct dp_rxdma_ring {
 	/* Protects bufs and free_ids */
 	spinlock_t bufs_lock;
 	int bufs_max;
+	/* Buffers that a replenish was asked for and could not allocate;
+	 * the next one adds them. Protected by the refill ring's lock.
+	 */
+	u32 refill_deficit;
 };
 
 #define ATH11K_TX_COMPL_NEXT(x)	(((x) + 1) % DP_TX_COMP_RING_SIZE)
--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -453,6 +453,15 @@ static struct sk_buff *ath11k_dp_rx_pp_a
 }
 
 /* Returns number of Rx buffers replenished */
+/* TEST-ONLY switch for the A/B of the refill ring service that does not wait
+ * for the polls that spend their budget first; dropped before this is
+ * upstreamed.
+ */
+bool ath11k_rx_refill_early = true;
+module_param_named(rx_refill_early, ath11k_rx_refill_early, bool, 0644);
+MODULE_PARM_DESC(rx_refill_early,
+		 "Serve the RX refill ring before the budgeted rings and carry over buffers that could not be allocated (default: on)");
+
 int ath11k_dp_rxbufs_replenish(struct ath11k_base *ab, int mac_id,
 			       struct dp_rxdma_ring *rx_ring,
 			       int req_entries,
@@ -476,8 +485,18 @@ int ath11k_dp_rxbufs_replenish(struct at
 	ath11k_hal_srng_access_begin(ab, srng);
 
 	num_free = ath11k_hal_srng_src_num_free(ab, srng, true);
+
+	/* The head has caught up with the hardware's tail: it has consumed
+	 * every buffer, and the firmware only logs that, then drops frames.
+	 */
+	if (num_free >= srng->ring_size / srng->entry_size - 1)
+		ab->soc_stats.rx_refill_empty[mac_id]++;
+
 	if (!req_entries && (num_free > (rx_ring->bufs_max * 3) / 4))
 		req_entries = num_free;
+	else if (req_entries && ath11k_rx_refill_early)
+		req_entries = min_t(int, req_entries + rx_ring->refill_deficit,
+				    rx_ring->bufs_max);
 
 	req_entries = min(num_free, req_entries);
 	num_remain = req_entries;
@@ -532,6 +551,9 @@ int ath11k_dp_rxbufs_replenish(struct at
 
 	ath11k_hal_srng_access_end(ab, srng);
 
+	if (ath11k_rx_refill_early && req_entries)
+		rx_ring->refill_deficit = num_remain;
+
 	spin_unlock_bh(&srng->lock);
 
 	return req_entries - num_remain;
@@ -549,6 +571,9 @@ fail_free_skb:
 
 	ath11k_hal_srng_access_end(ab, srng);
 
+	if (ath11k_rx_refill_early && req_entries)
+		rx_ring->refill_deficit = num_remain;
+
 	spin_unlock_bh(&srng->lock);
 
 	return req_entries - num_remain;
