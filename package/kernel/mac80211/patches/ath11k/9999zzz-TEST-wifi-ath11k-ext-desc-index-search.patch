+	/* TEST: extension descriptor frames sent with index search, and
+	 * refused for lack of the station's AST index
+	 */
+	atomic_t tx_ext_idx;
+	atomic_t tx_ext_noidx;
 	/* TEST: non-TSO scatter-gather frames refused for the TCP-only guard,
 	 * and ext frames held back until the station's first normal completion
 	 */
--- a/drivers/net/wireless/ath/ath11k/peer.c
+++ b/drivers/net/wireless/ath/ath11k/peer.c
@@ -448,6 +448,10 @@
 
 	if (sta) {
 		arsta = ath11k_sta_to_arsta(sta);
+		/* TEST: kept for index search of extension descriptor frames */
+		arsta->ast_idx = peer->hw_peer_id;
+		arsta->ast_hash = peer->ast_hash;
+		smp_store_release(&arsta->ast_valid, true);
 		arsta->tcl_metadata |= FIELD_PREP(HTT_TCL_META_DATA_TYPE, 0) |
 				       FIELD_PREP(HTT_TCL_META_DATA_PEER_ID,
 						  peer->peer_id);
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -10036,6 +10036,7 @@
 	kfree(arsta->tx_stats);
 	arsta->tx_stats = NULL;
 free_peer:
+	WRITE_ONCE(arsta->ast_valid, false);
 	ath11k_peer_delete(ar, arvif->vdev_id, sta->addr);
 free_rx_stats:
 	kfree(arsta->rx_stats);
@@ -10064,6 +10065,9 @@
 		}
 	}
 
+	/* TEST: no index search for a peer that is going away */
+	WRITE_ONCE(ath11k_sta_to_arsta(sta)->ast_valid, false);
+
 	ath11k_dp_peer_cleanup(ar, arvif->vdev_id, sta->addr);
 
 	ret = ath11k_peer_delete(ar, arvif->vdev_id, sta->addr);
