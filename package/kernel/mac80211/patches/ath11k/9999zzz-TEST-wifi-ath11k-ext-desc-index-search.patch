--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -609,6 +609,15 @@
 	bool ext_compl_seen;
 	atomic_t ext_logged;
 
+	/* TEST: the AST index and hash of the station's peer from the HTT
+	 * peer map event; ast_valid is set after them and cleared when the
+	 * station is removed
+	 */
+	u16 ast_idx;
+	u16 ast_hash;
+	bool ast_valid;
+	bool ast_logged;
+
 #ifdef CPTCFG_ATH11K_CFR
 	struct ath11k_per_peer_cfr_capture cfr_capture;
 #endif
@@ -973,6 +982,11 @@
