+++ b/drivers/net/wireless/ath/ath11k/dp_tx.c
@@ -97,6 +97,15 @@
 MODULE_PARM_DESC(ext_log_first,
 		 "Log the first frames of a station sent through extension descriptors (default: on)");
 
+/* TEST-ONLY: an extension descriptor frame is sent with index search on the
+ * AST entry of its station, not the address search of the vif; a frame whose
+ * station has no known index is made linear. Read for each frame.
+ */
+static bool ath11k_ext_index_search = true;
+module_param_named(ext_index_search, ath11k_ext_index_search, bool, 0644);
+MODULE_PARM_DESC(ext_index_search,
+		 "Extension descriptor frames use index search on the station's AST entry (default: on)");
+
 #define ATH11K_EXT_LOG_MAX	8
 
 /* The ethertype, IP protocol and L4 ports of an Ethernet frame. Returns 0 for
@@ -760,7 +769,8 @@
 	u16 lg_etype = 0, lg_sport = 0, lg_dport = 0;
 	u8 lg_proto = 0;
 	unsigned int lg_len = 0, lg_frags = 0, lg_segs = 0;
-	bool dolog = false;
+	bool dolog = false, idx_search = false, idx_log = false;
+	u16 sta_ast_idx = 0, sta_ast_hash = 0;
 	int i, j, r;
 
 	if (!READ_ONCE(ath11k_tso) || !ab->hw_params.tx_tso ||
@@ -820,6 +830,21 @@
 		return -EAGAIN;
 	}
 
+	/* TEST: index search on the station's AST entry */
+	if (READ_ONCE(ath11k_ext_index_search)) {
+		if (!arsta || !smp_load_acquire(&arsta->ast_valid)) {
+			atomic_inc(&ab->soc_stats.tx_ext_noidx);
+			return -EAGAIN;
+		}
+		sta_ast_idx = arsta->ast_idx;
+		sta_ast_hash = arsta->ast_hash;
+		idx_search = true;
+		if (!READ_ONCE(arsta->ast_logged)) {
+			WRITE_ONCE(arsta->ast_logged, true);
+			idx_log = true;
+		}
+	}
+
 	/* TEST: what the first frames of a station look like; read now, the
 	 * frame may be completed and freed once it is queued
 	 */
@@ -948,6 +973,13 @@
 	ti.lmac_id = ar->lmac_id;
 	ti.bss_ast_hash = arvif->ast_hash;
 	ti.bss_ast_idx = arvif->ast_idx;
+	if (idx_search) {
+		ti.addr_search_flags = HAL_TX_ADDRX_EN;
+		ti.search_type = HAL_TX_ADDR_SEARCH_INDEX;
+		ti.bss_ast_idx = sta_ast_idx;
+		/* the cache set is the low four bits of the hash */
+		ti.bss_ast_hash = sta_ast_hash & 0xF;
+	}
 	ti.rbm_id = ab->hw_params.hal_params->tcl2wbm_rbm_map[ti.ring_id].rbm_id;
 	ti.tid = ath11k_dp_tx_get_tid(skb);
 	if (tso)
@@ -988,6 +1020,12 @@
 	}
 
 	atomic_add(n, &ar->dp.num_tx_pending);
+	if (idx_search)
+		atomic_add(n, &ab->soc_stats.tx_ext_idx);
+	if (idx_log)
+		ath11k_info(ab, "ext desc index search sta %pM ast_idx %u ast_hash 0x%x cache_set %u\n",
+			    container_of((void *)arsta, struct ieee80211_sta, drv_priv)->addr,
+			    sta_ast_idx, sta_ast_hash, sta_ast_hash & 0xF);
 	if (tso) {
 		atomic_inc(&ab->soc_stats.tx_tso_batch);
 		atomic_add(n, &ab->soc_stats.tx_tso_seg);
