 		}
 
+		if (ath11k_dp_tx_buf_is_tso(msdu)) {
+			msdu = ath11k_dp_tx_tso_put(ab, tx_ring, msdu,
+						    tx_ring->page_dma[id]);
+			if (!msdu)
+				continue;
+		}
+
 		dma_unmap_single(ab->dev, ATH11K_SKB_CB(msdu)->paddr,
-				 msdu->len, DMA_TO_DEVICE);
+				 skb_headlen(msdu), DMA_TO_DEVICE);
 		dev_kfree_skb_any(msdu);
 	}
 }
@@ -1048,8 +1055,8 @@ void ath11k_dp_free(struct ath11k_base *
 	for (i = 0; i < ab->hw_params.hal_params->num_tx_rings; i++) {
 		spin_lock_bh(&dp->tx_ring[i].tx_idr_lock);
 		ath11k_dp_tx_pending_cleanup(ab, &dp->tx_ring[i]);
-		ath11k_dp_tx_bufs_free(&dp->tx_ring[i]);
 		spin_unlock_bh(&dp->tx_ring[i].tx_idr_lock);
+		ath11k_dp_tx_bufs_free(ab, &dp->tx_ring[i]);
 		kfree(dp->tx_ring[i].tx_status);
 		dp->tx_ring[i].tx_status = NULL;
 	}
@@ -1097,7 +1104,7 @@ int ath11k_dp_alloc(struct ath11k_base *
 	size = sizeof(struct hal_wbm_release_ring) * DP_TX_COMP_RING_SIZE;
 
 	for (i = 0; i < ab->hw_params.hal_params->num_tx_rings; i++) {
-		ret = ath11k_dp_tx_bufs_init(&dp->tx_ring[i]);
+		ret = ath11k_dp_tx_bufs_init(ab, &dp->tx_ring[i]);
 		if (ret)
 			goto fail_cmn_srng_cleanup;
 		spin_lock_init(&dp->tx_ring[i].tx_idr_lock);
diff -Naurp a/drivers/net/wireless/ath/ath11k/dp.h b/drivers/net/wireless/ath/ath11k/dp.h
--- a/drivers/net/wireless/ath/ath11k/dp.h	2026-10-21 19:36:05.624076540 +0200
+++ b/drivers/net/wireless/ath/ath11k/dp.h	2026-10-21 19:36:05.645960425 +0200
@@ -85,6 +85,13 @@ struct dp_rxdma_ring {
 
 #define ATH11K_TX_COMPL_NEXT(x)	(((x) + 1) % DP_TX_COMP_RING_SIZE)
 
+/* The payload pieces of one TSO segment, past the shared headers */
+struct ath11k_dp_tx_ext_map {
+	u32 dma[HAL_TX_MSDU_EXT_NUM_BUFS - 1];
+	u16 len[HAL_TX_MSDU_EXT_NUM_BUFS - 1];
