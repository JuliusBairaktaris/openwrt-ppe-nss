+
 struct dp_tx_ring {
 	u8 tcl_data_ring_id;
 	struct dp_srng tcl_data_ring;
@@ -95,7 +102,15 @@ struct dp_tx_ring {
 	u32 *page_dma;
 	u32 *free_ids;
 	u32 num_free;
-	/* Protects bufs and free_ids */
+	/* MSDU extension descriptors for TSO segments, the payload mappings
+	 * of each, and the slots not in use
+	 */
+	struct hal_tx_msdu_ext *ext;
+	dma_addr_t ext_paddr;
+	struct ath11k_dp_tx_ext_map *ext_map;
+	u16 *ext_free;
+	u32 ext_num_free;
+	/* Protects bufs, free_ids and ext_free */
 	spinlock_t tx_idr_lock;
 	/* Serializes wake_tx_queue operations for this ring */
 	spinlock_t wake_tx_lock;
@@ -219,6 +234,7 @@ struct ath11k_pdev_dp {
 #define DP_TCL_DATA_RING_SIZE_WCN6750	2048
 #define DP_TX_COMP_RING_SIZE		32768
 #define DP_TX_IDR_SIZE			DP_TX_COMP_RING_SIZE
+#define DP_TX_EXT_DESC_NUM		2048
 #define DP_TCL_CMD_RING_SIZE		32
 #define DP_TCL_STATUS_RING_SIZE		32
 #define DP_REO_DST_RING_MAX		4
diff -Naurp a/drivers/net/wireless/ath/ath11k/dp_tx.c b/drivers/net/wireless/ath/ath11k/dp_tx.c
--- a/drivers/net/wireless/ath/ath11k/dp_tx.c	2026-10-21 19:36:05.624151352 +0200
+++ b/drivers/net/wireless/ath/ath11k/dp_tx.c	2026-10-21 19:36:05.646082307 +0200
@@ -6,6 +6,7 @@
 
 #include <net/dsfield.h>
 #include <net/gso.h>
+#include <net/tcp.h>
 #include <net/xdp.h>
 
 #include "core.h"
@@ -16,6 +17,10 @@
 #include "peer.h"
 #include "mac.h"
 
+static bool ath11k_tso = true;
+module_param_named(tso, ath11k_tso, bool, 0644);
+MODULE_PARM_DESC(tso, "Let the TCL segment TCP batches");
+
 static enum hal_tcl_encap_type
 ath11k_dp_tx_get_encap_type(struct ath11k_vif *arvif, struct sk_buff *skb)
 {
@@ -87,7 +92,7 @@ enum hal_encrypt_type ath11k_dp_tx_get_e
  * ones: the completion's cookie names the buffer directly. Callers of the id
  * helpers hold tx_idr_lock.
  */
-int ath11k_dp_tx_bufs_init(struct dp_tx_ring *tx_ring)
+int ath11k_dp_tx_bufs_init(struct ath11k_base *ab, struct dp_tx_ring *tx_ring)
 {
 	u32 id;
 
@@ -97,8 +102,16 @@ int ath11k_dp_tx_bufs_init(struct dp_tx_
 				     sizeof(*tx_ring->page_dma), GFP_KERNEL);
 	tx_ring->free_ids = kvcalloc(DP_TX_IDR_SIZE - 1,
 				     sizeof(*tx_ring->free_ids), GFP_KERNEL);
-	if (!tx_ring->bufs || !tx_ring->page_dma || !tx_ring->free_ids) {
-		ath11k_dp_tx_bufs_free(tx_ring);
+	tx_ring->ext = dma_alloc_coherent(ab->dev, DP_TX_EXT_DESC_NUM *
+					  sizeof(*tx_ring->ext),
+					  &tx_ring->ext_paddr, GFP_KERNEL);
+	tx_ring->ext_map = kvcalloc(DP_TX_EXT_DESC_NUM,
+				    sizeof(*tx_ring->ext_map), GFP_KERNEL);
+	tx_ring->ext_free = kvcalloc(DP_TX_EXT_DESC_NUM,
+				     sizeof(*tx_ring->ext_free), GFP_KERNEL);
+	if (!tx_ring->bufs || !tx_ring->page_dma || !tx_ring->free_ids ||
+	    !tx_ring->ext || !tx_ring->ext_map || !tx_ring->ext_free) {
+		ath11k_dp_tx_bufs_free(ab, tx_ring);
 		return -ENOMEM;
 	}
 
@@ -106,18 +119,32 @@ int ath11k_dp_tx_bufs_init(struct dp_tx_
 	for (id = DP_TX_IDR_SIZE - 1; id--;)
 		tx_ring->free_ids[tx_ring->num_free++] = id;
 
+	tx_ring->ext_num_free = 0;
+	for (id = DP_TX_EXT_DESC_NUM; id--;)
+		tx_ring->ext_free[tx_ring->ext_num_free++] = id;
+
 	return 0;
 }
 
-void ath11k_dp_tx_bufs_free(struct dp_tx_ring *tx_ring)
+void ath11k_dp_tx_bufs_free(struct ath11k_base *ab, struct dp_tx_ring *tx_ring)
 {
 	kvfree(tx_ring->bufs);
 	kvfree(tx_ring->page_dma);
 	kvfree(tx_ring->free_ids);
+	if (tx_ring->ext)
+		dma_free_coherent(ab->dev,
+				  DP_TX_EXT_DESC_NUM * sizeof(*tx_ring->ext),
+				  tx_ring->ext, tx_ring->ext_paddr);
+	kvfree(tx_ring->ext_map);
+	kvfree(tx_ring->ext_free);
 	tx_ring->bufs = NULL;
 	tx_ring->page_dma = NULL;
 	tx_ring->free_ids = NULL;
+	tx_ring->ext = NULL;
+	tx_ring->ext_map = NULL;
+	tx_ring->ext_free = NULL;
 	tx_ring->num_free = 0;
+	tx_ring->ext_num_free = 0;
 }
 
 static int ath11k_dp_tx_buf_get_id(struct dp_tx_ring *tx_ring,
@@ -178,6 +205,40 @@ static struct xdp_frame *ath11k_dp_tx_bu
 	return (void *)((unsigned long)buf & ~ATH11K_DP_TX_BUF_XDP);
 }
 
+/* A TSO segment sits in the buffer table as its batch, tagged in bit 1, with
+ * the extension descriptor slot it uses in page_dma.
+ */
+#define ATH11K_DP_TX_BUF_TSO	BIT(1)
+
+bool ath11k_dp_tx_buf_is_tso(struct sk_buff *buf)
+{
+	return (unsigned long)buf & ATH11K_DP_TX_BUF_TSO;
+}
+
+struct sk_buff *ath11k_dp_tx_buf_tso(struct sk_buff *buf)
+{
+	return (void *)((unsigned long)buf & ~ATH11K_DP_TX_BUF_TSO);
+}
+
+/* Releases a completed TSO segment under tx_idr_lock. Returns its batch once
+ * the last segment of it is done, NULL before that.
+ */
+struct sk_buff *ath11k_dp_tx_tso_put(struct ath11k_base *ab,
+				     struct dp_tx_ring *tx_ring,
+				     struct sk_buff *buf, u32 slot)
+{
+	struct ath11k_dp_tx_ext_map *map = &tx_ring->ext_map[slot];
+	struct sk_buff *skb = ath11k_dp_tx_buf_tso(buf);
+	int i;
+
+	for (i = 0; i < map->num; i++)
+		dma_unmap_page(ab->dev, map->dma[i], map->len[i],
+			       DMA_TO_DEVICE);
+	tx_ring->ext_free[tx_ring->ext_num_free++] = slot;
+
+	return skb_unref(skb) ? skb : NULL;
+}
+
 void ath11k_dp_tx_xdp_release(struct ath11k_base *ab, struct sk_buff *buf,
 			      u32 dma, struct xdp_frame_bulk *bq)
 {
@@ -620,6 +681,257 @@ fail_remove_idr:
 	return ret;
 }
 
+/* Maps the payload of one segment, @len bytes from *@piece at *@off, where
+ * piece 0 is the linear part past the headers and piece n is fragment n - 1.
+ */
+static int ath11k_dp_tx_tso_map(struct device *dev, struct sk_buff *skb,
+				struct ath11k_dp_tx_ext_map *map,
+				struct hal_tx_msdu_ext *ext,
+				unsigned int *piece, unsigned int *off,
+				unsigned int len)
+{
+	struct skb_shared_info *shinfo = skb_shinfo(skb);
+	unsigned int avail, take;
+	dma_addr_t dma;
+
+	map->num = 0;
+	while (len) {
+		if (!*piece)
+			avail = skb_headlen(skb) - *off;
+		else
+			avail = skb_frag_size(&shinfo->frags[*piece - 1]) - *off;
+		if (!avail) {
+			if (*piece == shinfo->nr_frags)
+				return -EINVAL;
+			(*piece)++;
+			*off = 0;
+			continue;
+		}
+		if (map->num == HAL_TX_MSDU_EXT_NUM_BUFS - 1)
+			return -E2BIG;
+
+		take = min(avail, len);
+		if (!*piece)
+			dma = dma_map_single(dev, skb->data + *off, take,
+					     DMA_TO_DEVICE);
+		else
+			dma = skb_frag_dma_map(dev, &shinfo->frags[*piece - 1],
+					       *off, take, DMA_TO_DEVICE);
+		if (dma_mapping_error(dev, dma))
+			return -ENOMEM;
+
+		map->dma[map->num] = dma;
+		map->len[map->num] = take;
+		map->num++;
+		ext->buf[map->num].addr_lo = lower_32_bits(dma);
+		ext->buf[map->num].info =
+			FIELD_PREP(HAL_TX_MSDU_EXT_BUF_INFO_LEN, take);
+		*off += take;
+		len -= take;
+	}
+
+	return 0;
+}
+
+static void ath11k_dp_tx_tso_unmap(struct device *dev,
+				   struct ath11k_dp_tx_ext_map *map)
+{
+	while (map->num--)
+		dma_unmap_page(dev, map->dma[map->num], map->len[map->num],
+			       DMA_TO_DEVICE);
+	map->num = 0;
+}
+
+/* A TCP batch the TCL segments: each segment is one TCL entry pointing at
+ * an MSDU extension descriptor, which lists the headers shared by the batch
+ * and the segment's payload, and gives the segment's IP length, IP ID, TCP
+ * sequence number and flags for the TCL to write into the headers. Every
+ * segment holds a reference on the batch, and the completion of the last
+ * one reports the batch to mac80211.
+ *
+ * Returns -EAGAIN, with the batch untouched, for a batch the TCL cannot
+ * take whole; ids, extension descriptors and ring entries for all segments
+ * are taken before the first is queued.
+ */
+static int ath11k_dp_tx_tso(struct ath11k *ar, struct ath11k_vif *arvif,
+			    struct sk_buff *skb, int held_ring)
+{
+	struct skb_shared_info *shinfo = skb_shinfo(skb);
+	struct ath11k_skb_cb *skb_cb = ATH11K_SKB_CB(skb);
+	unsigned int n = shinfo->gso_segs, mss = shinfo->gso_size;
+	unsigned int hdr_len, l2_len, left, piece = 0, off;
+	struct ath11k_base *ab = ar->ab;
+	struct hal_tx_info ti = {};
+	struct dp_tx_ring *tx_ring;
+	struct hal_srng *tcl_ring;
+	u16 ids[ATH11K_TX_BATCH_MAX], slots[ATH11K_TX_BATCH_MAX];
+	u32 seq, flags, ip_id = 0;
+	dma_addr_t hdr_dma;
+	struct tcphdr *th;
+	int i, j, ret = -EAGAIN;
+
+	if (!(shinfo->gso_type & (SKB_GSO_TCPV4 | SKB_GSO_TCPV6)) ||
+	    shinfo->gso_type & SKB_GSO_FRAGLIST || skb_has_frag_list(skb) ||
+	    skb->ip_summed != CHECKSUM_PARTIAL || n > ATH11K_TX_BATCH_MAX ||
+	    refcount_read(&skb->users) != 1 ||
+	    ieee80211_vif_is_mesh(arvif->vif))
+		return -EAGAIN;
+
+	hdr_len = skb_tcp_all_headers(skb);
+	l2_len = skb_network_offset(skb);
+	if (hdr_len > skb_headlen(skb) || l2_len > hdr_len)
+		return -EAGAIN;
+
+	if (held_ring >= 0)
+		ti.ring_id = held_ring;
+	else
+		ti.ring_id = ab->hw_params.hw_ops->get_ring_selector(skb_get_queue_mapping(skb)) %
+			     ab->hw_params.hal_params->num_tx_rings;
+	tx_ring = &ab->dp.tx_ring[ti.ring_id];
+	tcl_ring = &ab->hal.srng_list[tx_ring->tcl_data_ring.ring_id];
+
+	spin_lock_bh(&tx_ring->tx_idr_lock);
+	if (tx_ring->num_free < n || tx_ring->ext_num_free < n) {
+		spin_unlock_bh(&tx_ring->tx_idr_lock);
+		return -EAGAIN;
+	}
+	for (i = 0; i < n; i++) {
+		slots[i] = tx_ring->ext_free[--tx_ring->ext_num_free];
+		ids[i] = ath11k_dp_tx_buf_get_id(tx_ring,
+						 (void *)((unsigned long)skb |
+							  ATH11K_DP_TX_BUF_TSO));
+		tx_ring->page_dma[ids[i]] = slots[i];
+	}
+	spin_unlock_bh(&tx_ring->tx_idr_lock);
+
+	hdr_dma = dma_map_single(ab->dev, skb->data, skb_headlen(skb),
+				 DMA_TO_DEVICE);
+	if (dma_mapping_error(ab->dev, hdr_dma)) {
+		i = 0;
+		goto fail_put;
+	}
+
+	th = tcp_hdr(skb);
+	seq = ntohl(th->seq);
+	flags = (ntohl(tcp_flag_word(th)) >> 16) & 0x1ff;
+	if (shinfo->gso_type & SKB_GSO_TCPV4)
+		ip_id = ntohs(ip_hdr(skb)->id);
+
+	off = hdr_len;
+	left = skb->len - hdr_len;
+	for (i = 0; i < n; i++) {
+		struct hal_tx_msdu_ext *ext = &tx_ring->ext[slots[i]];
+		struct ath11k_dp_tx_ext_map *map = &tx_ring->ext_map[slots[i]];
+		unsigned int len = min(left, mss);
+		u32 seg_flags = flags;
+
+		if (i)
+			seg_flags &= ~TCPHDR_CWR;
+		if (i < n - 1)
+			seg_flags &= ~(TCPHDR_FIN | TCPHDR_PSH);
+
+		memset(ext, 0, sizeof(*ext));
+		if (ath11k_dp_tx_tso_map(ab->dev, skb, map, ext, &piece, &off,
+					 len)) {
+			ath11k_dp_tx_tso_unmap(ab->dev, map);
+			goto fail_unmap;
+		}
+
+		ext->info0 = FIELD_PREP(HAL_TX_MSDU_EXT_INFO0_TSO_ENABLE, 1) |
+			     FIELD_PREP(HAL_TX_MSDU_EXT_INFO0_TCP_FLAG,
+					seg_flags) |
+			     FIELD_PREP(HAL_TX_MSDU_EXT_INFO0_TCP_FLAG_MASK,
+					0x1ff);
+		ext->info1 = FIELD_PREP(HAL_TX_MSDU_EXT_INFO1_L2_LEN, l2_len) |
+			     FIELD_PREP(HAL_TX_MSDU_EXT_INFO1_IP_LEN,
+					hdr_len - l2_len + len);
+		ext->tcp_seq = seq;
+		ext->info3 = FIELD_PREP(HAL_TX_MSDU_EXT_INFO3_IP_ID, ip_id);
+		ext->buf[0].addr_lo = lower_32_bits(hdr_dma);
+		ext->buf[0].info = FIELD_PREP(HAL_TX_MSDU_EXT_BUF_INFO_LEN,
+					      hdr_len);
+
+		seq += len;
+		left -= len;
+		if (!(shinfo->gso_type & SKB_GSO_TCP_FIXEDID))
+			ip_id = (ip_id + 1) & 0xffff;
+	}
+
+	if (held_ring < 0) {
+		spin_lock_bh(&tcl_ring->lock);
+		ath11k_hal_srng_access_begin(ab, tcl_ring);
+	}
+	if (ath11k_hal_srng_src_num_free(ab, tcl_ring, held_ring < 0) < n) {
+		if (held_ring < 0) {
+			ath11k_hal_srng_access_end(ab, tcl_ring);
+			spin_unlock_bh(&tcl_ring->lock);
+		}
+		ab->soc_stats.tx_err.desc_na[ti.ring_id]++;
+		goto fail_unmap;
+	}
+
+	skb_cb->paddr = hdr_dma;
+	skb_cb->vif = arvif->vif;
+	skb_cb->ar = ar;
+	refcount_add(n - 1, &skb->users);
+
+	ti.encap_type = HAL_TCL_ENCAP_TYPE_ETHERNET;
+	ti.meta_data_flags = arvif->tcl_metadata;
+	ti.addr_search_flags = arvif->hal_addr_search_flags;
+	ti.search_type = arvif->search_type;
+	ti.type = HAL_TCL_DESC_TYPE_EXT_DESC;
+	ti.lmac_id = ar->lmac_id;
+	ti.bss_ast_hash = arvif->ast_hash;
+	ti.bss_ast_idx = arvif->ast_idx;
+	ti.rbm_id = ab->hw_params.hal_params->tcl2wbm_rbm_map[ti.ring_id].rbm_id;
+	ti.tid = ath11k_dp_tx_get_tid(skb);
+	ti.flags0 = FIELD_PREP(HAL_TCL_DATA_CMD_INFO1_IP4_CKSUM_EN, 1) |
+		    FIELD_PREP(HAL_TCL_DATA_CMD_INFO1_TCP4_CKSUM_EN, 1) |
+		    FIELD_PREP(HAL_TCL_DATA_CMD_INFO1_TCP6_CKSUM_EN, 1);
+	ti.flags1 = FIELD_PREP(HAL_TCL_DATA_CMD_INFO2_TID_OVERWRITE, 1);
+
+	left = skb->len - hdr_len;
+	for (i = 0; i < n; i++) {
+		unsigned int len = min(left, mss);
+
+		ti.desc_id = FIELD_PREP(DP_TX_DESC_ID_MAC_ID, ar->pdev_idx) |
+			     FIELD_PREP(DP_TX_DESC_ID_MSDU_ID, ids[i]) |
+			     FIELD_PREP(DP_TX_DESC_ID_POOL_ID,
+					skb_get_queue_mapping(skb));
+		ti.paddr = tx_ring->ext_paddr + slots[i] * sizeof(*tx_ring->ext);
+		ti.data_len = hdr_len + len;
+		ath11k_hal_tx_cmd_desc_setup(ab,
+					     ath11k_hal_srng_src_get_next_entry(ab, tcl_ring) +
+					     sizeof(struct hal_tlv_hdr), &ti);
+		left -= len;
+	}
+
+	if (held_ring < 0) {
+		ath11k_hal_srng_access_end(ab, tcl_ring);
+		ath11k_dp_shadow_start_timer(ab, tcl_ring,
+					     &ab->dp.tx_ring_timer[ti.ring_id]);
+		spin_unlock_bh(&tcl_ring->lock);
+	}
+
+	atomic_add(n, &ar->dp.num_tx_pending);
+
+	return 0;
+
+fail_unmap:
+	for (j = 0; j < i; j++)
+		ath11k_dp_tx_tso_unmap(ab->dev, &tx_ring->ext_map[slots[j]]);
+	dma_unmap_single(ab->dev, hdr_dma, skb_headlen(skb), DMA_TO_DEVICE);
+fail_put:
+	spin_lock_bh(&tx_ring->tx_idr_lock);
+	for (j = n; j--;) {
+		ath11k_dp_tx_buf_put_id(tx_ring, ids[j]);
+		tx_ring->ext_free[tx_ring->ext_num_free++] = slots[j];
+	}
+	spin_unlock_bh(&tx_ring->tx_idr_lock);
+
+	return ret;
+}
+
 /* A GSO frame from mac80211 is a batch the driver splits, and its frames
  * share the one status mac80211 expects: the last frame reports it with
  * the airtime of the batch, and the others are freed without one. A batch
@@ -630,8 +942,12 @@ int ath11k_dp_tx_gso(struct ath11k *ar,
 		     int held_ring)
 {
 	struct sk_buff *segs, *seg, *next;
-	int ret = 0;
+	int ret;
 
+	if (READ_ONCE(ath11k_tso) && !ath11k_dp_tx_tso(ar, arvif, skb, held_ring))
+		return 0;
+
+	ret = 0;
