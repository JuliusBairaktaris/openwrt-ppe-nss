+/* TEST: checks a completion's id against what the id holds, under the id
+ * lock and before the id is released. Returns false for a completion of an
+ * older issue of the id, which must not touch the frame the id holds now.
+ */
+static bool ath11k_dp_tx_compl_check(struct ath11k_base *ab,
+				     struct dp_tx_ring *tx_ring,
+				     const struct hal_wbm_release_ring *d,
+				     u8 src, u32 status)
+{
+	static const char * const path[] = { "none", "wbm", "htt" };
+	u32 cookie = FIELD_GET(BUFFER_ADDR_INFO1_SW_COOKIE,
+			       d->buf_addr_info.info1);
+	u32 raw = FIELD_GET(DP_TX_DESC_ID_MSDU_ID, cookie);
+	u32 id = raw & ATH11K_TX_ID_MASK;
+	u8 gen = FIELD_GET(ATH11K_TX_ID_GEN, raw);
+	u8 type = FIELD_GET(HAL_WBM_RELEASE_INFO0_DESC_TYPE, d->info0);
+	u8 rel_src = FIELD_GET(HAL_WBM_RELEASE_INFO0_REL_SRC_MODULE, d->info0);
+	u64 addr = ((u64)FIELD_GET(BUFFER_ADDR_INFO1_ADDR,
+				   d->buf_addr_info.info1) << 32) |
+		   d->buf_addr_info.info0;
+	bool log = READ_ONCE(ath11k_tx_compl_log);
+	struct ath11k_dp_tx_compl_rec *last, prev;
+	const char *what = NULL;
+	bool ok = true;
+
+	if (unlikely(id >= DP_TX_IDR_SIZE - 1))
+		return true;
+
+	last = &tx_ring->id_last[id];
+	prev = *last;
+
+	if (unlikely(!tx_ring->bufs[id])) {
+		what = "unknown msdu_id";
+	} else if (unlikely(READ_ONCE(ath11k_tx_id_gen) &&
+			    gen != tx_ring->id_gen[id])) {
+		what = "stale generation";
+		atomic_inc(&ab->soc_stats.tx_stale_compl);
+		ok = false;
+	} else if (unlikely(addr != tx_ring->id_addr[id])) {
+		what = "address mismatch";
+		atomic_inc(&ab->soc_stats.tx_addr_mismatch);
+	}
+
+	if (unlikely(what)) {
+		ath11k_warn(ab,
+			    "tx completion %s: path %s id %u gen expected %u got %u rel_src %u %s %u buf_type %u addr returned 0x%llx queued 0x%llx\n",
+			    what, path[src], id, tx_ring->id_gen[id], gen,
+			    rel_src, src == 2 ? "htt_status" : "tqm_reason",
+			    status, type, addr, tx_ring->id_addr[id]);
+		if (log && prev.src)
+			ath11k_warn(ab,
+				    "tx completion id %u previous: path %s %s %u buf_type %u gen %u addr 0x%llx %ums ago\n",
+				    id, path[prev.src],
+				    prev.src == 2 ? "htt_status" : "tqm_reason",
+				    prev.status, prev.type, prev.gen, prev.addr,
+				    jiffies_to_msecs(jiffies - prev.jiffies));
+	}
+
+	if (log && ok) {
+		last->jiffies = jiffies;
+		last->addr = addr;
+		last->status = status;
+		last->src = src;
+		last->type = type;
+		last->gen = gen;
+	}
+
+	return ok;
+}
