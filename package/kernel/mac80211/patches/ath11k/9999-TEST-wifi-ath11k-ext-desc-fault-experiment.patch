+/* The buffer ids are below DP_TX_IDR_SIZE, 15 bits, of the 17 the cookie has
+ * for them: the generation takes the two above.
+ */
+#define ATH11K_TX_ID_MASK	GENMASK(14, 0)
+#define ATH11K_TX_ID_GEN	GENMASK(16, 15)
+#define ATH11K_TX_COOKIE_ID(c)	(FIELD_GET(DP_TX_DESC_ID_MSDU_ID, c) & ATH11K_TX_ID_MASK)
+#define ATH11K_TX_EXT_SLOT_WIDE	136
+
+static_assert(DP_TX_IDR_SIZE <= ATH11K_TX_ID_MASK + 1);
+
+static inline struct hal_tx_msdu_ext *
+ath11k_dp_tx_ext_slot(struct dp_tx_ring *tx_ring, unsigned int slot)
+{
+	return (void *)((u8 *)tx_ring->ext + slot * tx_ring->ext_stride);
+}
+
+/* The id and its generation, as they go in the cookie. Under the id lock, or
+ * for an id the caller holds.
+ */
+static inline u32 ath11k_dp_tx_id_cookie(struct dp_tx_ring *tx_ring, u32 id)
+{
+	return FIELD_PREP(ATH11K_TX_ID_MASK, id) |
+	       FIELD_PREP(ATH11K_TX_ID_GEN, tx_ring->id_gen[id]);
+}
