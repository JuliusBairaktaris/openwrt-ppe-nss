+/* TEST-ONLY: keep the last completion of each id, and print it next to the
+ * current one when a completion is stale, unknown or returns another address.
+ */
+static bool ath11k_tx_compl_log = true;
+module_param_named(tx_compl_log, ath11k_tx_compl_log, bool, 0644);
+MODULE_PARM_DESC(tx_compl_log,
+		 "Keep the last completion of each TX buffer id (default: on)");
