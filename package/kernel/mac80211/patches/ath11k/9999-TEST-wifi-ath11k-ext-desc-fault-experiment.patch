+/* TEST-ONLY: extension descriptor slots of the vendor's size, with the bytes
+ * past the descriptor cleared whenever a slot is built, instead of the
+ * descriptors back to back. Read when the rings are allocated, so a change
+ * takes effect with the next load of the module.
+ */
+static bool ath11k_ext_slot_wide = true;
+module_param_named(ext_slot_wide, ath11k_ext_slot_wide, bool, 0644);
+MODULE_PARM_DESC(ext_slot_wide,
+		 "136 byte extension descriptor slots, zero tailed; read at module load (default: on)");
+
+/* TEST-ONLY: the spare bits of the buffer id in the TCL cookie carry a
+ * generation, kept for each id and counted up each time the id is issued. A
+ * completion that returns another generation than the id's is counted and
+ * dropped without touching the frame the id holds now. The generation is
+ * always sent; the switch only decides whether it is checked.
+ */
+static bool ath11k_tx_id_gen = true;
+module_param_named(tx_id_gen, ath11k_tx_id_gen, bool, 0644);
+MODULE_PARM_DESC(tx_id_gen,
+		 "Check the generation of a TX completion's buffer id (default: on)");
