TEST: wifi: ath11k: add a tso switch for A/B tests

Test only, dropped before this is upstreamed. Add the module parameter
tso (bool, 0644, default on). At load it decides whether the netdevs
offer scatter-gather, TSO and frame lists; for each frame, off sends a
TCP batch segmented in software and a frame with fragments made linear,
as the stack would, so both paths can be compared in one boot.

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>

--- a/drivers/net/wireless/ath/ath11k/dp_tx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_tx.c
@@ -15,6 +15,15 @@
 #include "peer.h"
 #include "mac.h"
 
+/* TEST-ONLY switch for the A/B of the TCL segmentation and scatter-gather
+ * against the software path; dropped before this is upstreamed. Read when the
+ * radio is registered, for the netdev features, and for each frame: off, a
+ * batch is segmented and a frame with fragments made linear in the driver.
+ */
+static bool ath11k_tso = true;
+module_param_named(tso, ath11k_tso, bool, 0644);
+MODULE_PARM_DESC(tso, "Offer TSO and scatter-gather, and send frames from MSDU extension descriptors (default: on)");
+
 /* TEST-ONLY switch for the A/B of frame list aggregates against the stack
  * splitting them before the driver; read when the radio is registered.
  * Dropped before this is upstreamed.
@@ -32,7 +41,7 @@ bool ath11k_dp_tx_fraglist_wanted(struct
 /* Whether the netdevs of this device offer TSO and scatter-gather */
 bool ath11k_dp_tx_tso_wanted(struct ath11k_base *ab)
 {
-	return ab->hw_params.tx_tso;
+	return ab->hw_params.tx_tso && READ_ONCE(ath11k_tso);
 }
 
 static enum hal_tcl_encap_type
@@ -650,7 +659,7 @@ static int ath11k_dp_tx_ext(struct ath11
 	unsigned int pad;
 	int i, j;
 
-	if (!ab->hw_params.tx_tso ||
+	if (!READ_ONCE(ath11k_tso) || !ab->hw_params.tx_tso ||
 	    !(info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP) ||
 	    ath11k_dp_tx_get_encap_type(arvif, skb) != HAL_TCL_ENCAP_TYPE_ETHERNET ||
 	    skb_has_frag_list(skb) || refcount_read(&skb->users) != 1 ||
