 #include "mac.h"
 
+/* TEST-ONLY switch for the A/B of the TCL segmentation and scatter-gather
+ * against the software path; dropped before this is upstreamed. Read when the
+ * radio is registered, for the netdev features, and for each frame: off, a
+ * batch is segmented and a frame with fragments made linear in the driver.
