+/* Slides the first @len bytes of the frame down by @pad bytes, so that they end
+ * @pad bytes lower, and the bytes @pad past them stay where they were: the
+ * Android host driver does this to the headers of a batch to end the buffer of
+ * the headers on an 8 byte boundary, with the offsets of the headers. The
+ * frame is longer by @pad, the bytes between the slid part and the rest being
+ * the ones the slide left. Undone by ath11k_dp_tx_ext_unpad(). The head room
+ * and an unshared head are the caller's.
+ */
+static void ath11k_dp_tx_ext_pad(struct sk_buff *skb, unsigned int len,
+				 unsigned int pad)
+{
+	skb_push(skb, pad);
+	memmove(skb->data, skb->data + pad, len);
+	if (skb_mac_header_was_set(skb))
+		skb->mac_header -= pad;
+	if (skb->network_header != (typeof(skb->network_header))~0U)
+		skb->network_header -= pad;
+	if (skb->transport_header != (typeof(skb->transport_header))~0U)
+		skb->transport_header -= pad;
+}
+
+static void ath11k_dp_tx_ext_unpad(struct sk_buff *skb, unsigned int len,
+				   unsigned int pad)
+{
+	memmove(skb->data + pad, skb->data, len);
+	skb_pull(skb, pad);
+	if (skb_mac_header_was_set(skb))
+		skb->mac_header += pad;
+	if (skb->network_header != (typeof(skb->network_header))~0U)
+		skb->network_header += pad;
+	if (skb->transport_header != (typeof(skb->transport_header))~0U)
+		skb->transport_header += pad;
+}
