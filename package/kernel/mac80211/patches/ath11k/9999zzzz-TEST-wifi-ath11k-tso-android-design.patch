+/* The byte offset of a descriptor slot in the descriptor memory: back to back,
+ * or, with ext_per_page set, as many to a 4096 byte block as fit and none
+ * across a block.
+ */
+static inline size_t ath11k_dp_tx_ext_off(struct dp_tx_ring *tx_ring,
+					  unsigned int slot)
+{
+	if (tx_ring->ext_per_page)
+		return (slot / tx_ring->ext_per_page) * ATH11K_TX_EXT_BOUNDARY +
+		       (slot % tx_ring->ext_per_page) * tx_ring->ext_stride;
+
+	return slot * tx_ring->ext_stride;
+}
+
+static inline size_t ath11k_dp_tx_ext_size(struct dp_tx_ring *tx_ring)
+{
+	if (tx_ring->ext_per_page)
+		return DIV_ROUND_UP(DP_TX_EXT_DESC_NUM, tx_ring->ext_per_page) *
+		       ATH11K_TX_EXT_BOUNDARY;
+
+	return DP_TX_EXT_DESC_NUM * tx_ring->ext_stride;
+}
