 	skb_cb = ATH11K_SKB_CB(msdu);
 	info = IEEE80211_SKB_CB(msdu);
 
@@ -500,7 +725,8 @@ ath11k_dp_tx_process_htt_tx_complete(str
 		else
 			ts.peer_id = HTT_INVALID_PEER_ID;
 
-		ath11k_dp_tx_htt_tx_complete_buf(ab, tx_ring, &ts, push);
