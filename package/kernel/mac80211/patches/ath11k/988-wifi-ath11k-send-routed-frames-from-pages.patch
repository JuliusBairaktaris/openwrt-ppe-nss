+static u8 ath11k_dp_tx_tid_to_ac(u8 tid)
+{
+	static const u8 ac[] = {
+		IEEE80211_AC_BE, IEEE80211_AC_BK, IEEE80211_AC_BK,
+		IEEE80211_AC_BE, IEEE80211_AC_VI, IEEE80211_AC_VI,
+		IEEE80211_AC_VO, IEEE80211_AC_VO,
+	};
+
+	return ac[tid & 7];
+}
+
+/* A page sent on its own sits in the buffer table tagged in its low bit, which
+ * the alignment of struct page leaves clear.
+ */
+#define ATH11K_DP_TX_BUF_PAGE	BIT(0)
+
+bool ath11k_dp_tx_buf_is_page(struct sk_buff *buf)
+{
+	return (unsigned long)buf & ATH11K_DP_TX_BUF_PAGE;
+}
+
+void ath11k_dp_tx_page_release(struct ath11k_base *ab, struct sk_buff *buf,
+			       u32 dma)
+{
+	struct page *page = (void *)((unsigned long)buf &
+				     ~ATH11K_DP_TX_BUF_PAGE);
+
+	dma_unmap_page_attrs(ab->dev, dma & PAGE_MASK, page_size(page),
+			     DMA_TO_DEVICE, DMA_ATTR_SKIP_CPU_SYNC);
+	/* Nothing wrote to the page, so the pool has no lines to clean. */
+	if (page_pool_page_is_pp(page))
+		page_pool_put_page(page->pp, page, 0, false);
+	else
+		put_page(page);
+}
+
+void ath11k_dp_tx_page_flush(struct net_device *dev)
+{
+	struct ieee80211_vif *vif = wdev_to_ieee80211_vif(dev->ieee80211_ptr);
+	struct ath11k_base *ab;
+	struct hal_srng *tcl_ring;
+	unsigned long ring;
+	u32 id;
+
+	if (unlikely(!vif))
+		return;
+
+	ab = ath11k_vif_to_arvif(vif)->ar->ab;
+	for_each_set_bit(ring, &ab->dp.page_tx_pending,
+			 ab->hw_params.hal_params->num_tx_rings) {
+		if (!test_and_clear_bit(ring, &ab->dp.page_tx_pending))
+			continue;
+
+		id = ab->dp.tx_ring[ring].tcl_data_ring.ring_id;
+		tcl_ring = &ab->hal.srng_list[id];
+		spin_lock_bh(&tcl_ring->lock);
+		if (likely(!test_bit(ATH11K_FLAG_CRASH_FLUSH,
+				     &ab->dev_flags))) {
+			ath11k_hal_srng_access_end(ab, tcl_ring);
+			ath11k_dp_shadow_start_timer(ab, tcl_ring,
+						     &ab->dp.tx_ring_timer[ring]);
+		}
+		spin_unlock_bh(&tcl_ring->lock);
+	}
+}
+
+/* A routed frame handed over by the switch driver as a page: the switch has
+ * built its Ethernet header and nothing on the CPU has written to it, so its
+ * cache lines are clean and it is mapped without a sync. The hardware adds the
+ * 802.11 header and finds the station from the destination address.
+ *
+ * Frames the radio would treat differently from mac80211 stay with mac80211:
+ * the TXQs must be off, the interface must use Ethernet encapsulation, and
+ * the station must be authorized with a cipher the hardware handles on its
+ * own. Returning false leaves the page with the caller.
+ */
+bool ath11k_dp_tx_page(struct net_device *dev, struct page *page,
+		       unsigned int off, unsigned int len)
+{
+	struct ieee80211_vif *vif = wdev_to_ieee80211_vif(dev->ieee80211_ptr);
+	const struct ethhdr *eth = page_address(page) + off;
+	struct ath11k_vif *arvif;
+	struct ieee80211_sta *sta;
+	struct hal_tx_info ti = {};
+	struct dp_tx_ring *tx_ring;
+	struct hal_srng *tcl_ring;
+	struct ath11k_base *ab;
+	struct ath11k *ar;
+	void *hal_tcl_desc;
+	dma_addr_t dma;
+	u8 dsfield, ac;
+	int id;
+
+	if (unlikely(!vif || len > ~PAGE_MASK))
+		return false;
+
+	arvif = ath11k_vif_to_arvif(vif);
+	ar = arvif->ar;
+	ab = ar->ab;
+
+	if (unlikely(!ieee80211_vif_direct_tx(vif) ||
+		     !(vif->offload_flags & IEEE80211_OFFLOAD_ENCAP_ENABLED) ||
+		     test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags) ||
+		     is_multicast_ether_addr(eth->h_dest)))
+		return false;
+
+	switch (eth->h_proto) {
+	case htons(ETH_P_IP):
+		dsfield = ipv4_get_dsfield((const void *)(eth + 1));
+		break;
+	case htons(ETH_P_IPV6):
+		dsfield = ipv6_get_dsfield((const void *)(eth + 1));
+		break;
+	default:
+		return false;
+	}
+
+	sta = ieee80211_find_sta(vif, eth->h_dest);
+	if (unlikely(!sta || !READ_ONCE(ath11k_sta_to_arsta(sta)->page_tx) ||
+		     ath11k_sta_to_arsta(sta)->use_4addr_set))
+		return false;
+
+	ti.tid = ieee80211_dscp_to_tid(vif, sta, dsfield);
+	ac = ath11k_dp_tx_tid_to_ac(ti.tid);
+
+	dma = dma_map_page_attrs(ab->dev, page, 0, page_size(page),
+				 DMA_TO_DEVICE, DMA_ATTR_SKIP_CPU_SYNC);
+	if (unlikely(dma_mapping_error(ab->dev, dma)))
+		return false;
+	if (unlikely(upper_32_bits(dma)))
+		goto unmap;
+
+	ti.ring_id = ab->hw_params.hw_ops->get_ring_selector(ac) %
+		     ab->hw_params.hal_params->num_tx_rings;
+	ti.rbm_id = ab->hw_params.hal_params->tcl2wbm_rbm_map[ti.ring_id].rbm_id;
+	tx_ring = &ab->dp.tx_ring[ti.ring_id];
+
+	spin_lock_bh(&tx_ring->tx_idr_lock);
+	id = ath11k_dp_tx_buf_get_id(tx_ring, (void *)((unsigned long)page |
+						       ATH11K_DP_TX_BUF_PAGE));
+	if (likely(id >= 0))
+		tx_ring->page_dma[id] = dma | len;
+	spin_unlock_bh(&tx_ring->tx_idr_lock);
+	if (unlikely(id < 0))
+		goto unmap;
+
+	ti.desc_id = FIELD_PREP(DP_TX_DESC_ID_MAC_ID, ar->pdev_idx) |
+		     FIELD_PREP(DP_TX_DESC_ID_MSDU_ID, id) |
+		     FIELD_PREP(DP_TX_DESC_ID_POOL_ID, ac);
+	ti.encap_type = HAL_TCL_ENCAP_TYPE_ETHERNET;
+	ti.meta_data_flags = arvif->tcl_metadata;
+	ti.addr_search_flags = arvif->hal_addr_search_flags;
+	ti.search_type = arvif->search_type;
+	ti.type = HAL_TCL_DESC_TYPE_BUFFER;
+	ti.lmac_id = ar->lmac_id;
+	ti.bss_ast_hash = arvif->ast_hash;
+	ti.bss_ast_idx = arvif->ast_idx;
+	ti.flags1 = FIELD_PREP(HAL_TCL_DATA_CMD_INFO2_TID_OVERWRITE, 1);
+	ti.paddr = dma + off;
+	ti.data_len = len;
+
+	/* The tail pointer is read only when the ring looks full, and the head
+	 * pointer is written by ath11k_dp_tx_page_flush.
+	 */
+	tcl_ring = &ab->hal.srng_list[tx_ring->tcl_data_ring.ring_id];
+	spin_lock_bh(&tcl_ring->lock);
+	hal_tcl_desc = ath11k_hal_srng_src_get_next_entry(ab, tcl_ring);
+	if (unlikely(!hal_tcl_desc)) {
+		ath11k_hal_srng_access_begin(ab, tcl_ring);
+		hal_tcl_desc = ath11k_hal_srng_src_get_next_entry(ab, tcl_ring);
+	}
+	if (unlikely(!hal_tcl_desc)) {
+		spin_unlock_bh(&tcl_ring->lock);
+		ab->soc_stats.tx_err.desc_na[ti.ring_id]++;
+		spin_lock_bh(&tx_ring->tx_idr_lock);
+		ath11k_dp_tx_buf_put_id(tx_ring, id);
+		spin_unlock_bh(&tx_ring->tx_idr_lock);
+		goto unmap;
+	}
+	ath11k_hal_tx_cmd_desc_setup(ab, hal_tcl_desc +
+				     sizeof(struct hal_tlv_hdr), &ti);
+	if (!test_bit(ti.ring_id, &ab->dp.page_tx_pending))
+		set_bit(ti.ring_id, &ab->dp.page_tx_pending);
+	spin_unlock_bh(&tcl_ring->lock);
+
+	atomic_inc(&ar->dp.num_tx_pending);
+	dev_sw_netstats_tx_add(dev, 1, len);
+
+	return true;
+
+unmap:
+	dma_unmap_page_attrs(ab->dev, dma, page_size(page), DMA_TO_DEVICE,
+			     DMA_ATTR_SKIP_CPU_SYNC);
+	return false;
+}
+
 /* A caller that passes @held_ring holds that TCL ring's lock with an access
  * open, and ends the access itself once it has queued its last frame; the frame
  * goes on that ring or not at all.
@@ -370,9 +573,12 @@ static void ath11k_dp_tx_free_txbuf(stru
 	struct ath11k *ar;
