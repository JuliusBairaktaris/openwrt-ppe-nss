+static u8 ath11k_dp_tx_tid_to_ac(u8 tid)
+{
+	static const u8 ac[] = {
+		IEEE80211_AC_BE, IEEE80211_AC_BK, IEEE80211_AC_BK,
+		IEEE80211_AC_BE, IEEE80211_AC_VI, IEEE80211_AC_VI,
+		IEEE80211_AC_VO, IEEE80211_AC_VO,
+	};
+
+	return ac[tid & 7];
+}
+
+/* A frame redirected from another device sits in the buffer table tagged in
+ * its low bit, which the alignment of struct xdp_frame leaves clear.
+ */
+#define ATH11K_DP_TX_BUF_XDP	BIT(0)
+
+bool ath11k_dp_tx_buf_is_xdp(struct sk_buff *buf)
+{
+	return (unsigned long)buf & ATH11K_DP_TX_BUF_XDP;
+}
+
+static struct xdp_frame *ath11k_dp_tx_buf_xdp(struct sk_buff *buf)
+{
+	return (void *)((unsigned long)buf & ~ATH11K_DP_TX_BUF_XDP);
+}
+
+void ath11k_dp_tx_xdp_release(struct ath11k_base *ab, struct sk_buff *buf,
+			      u32 dma, struct xdp_frame_bulk *bq)
+{
+	struct xdp_frame *xdpf = ath11k_dp_tx_buf_xdp(buf);
+
+	dma_unmap_single(ab->dev, dma, xdpf->len, DMA_TO_DEVICE);
+	if (bq)
+		xdp_return_frame_bulk(xdpf, bq);
+	else
+		xdp_return_frame(xdpf);
+}
+
+static void ath11k_dp_tx_xdp_ring_end(struct ath11k_base *ab, int ring)
+{
+	struct hal_srng *tcl_ring;
+
+	tcl_ring = &ab->hal.srng_list[ab->dp.tx_ring[ring].tcl_data_ring.ring_id];
+	ath11k_hal_srng_access_end(ab, tcl_ring);
+	ath11k_dp_shadow_start_timer(ab, tcl_ring, &ab->dp.tx_ring_timer[ring]);
+}
+
+static void ath11k_dp_tx_xdp_flush(struct ath11k_base *ab)
+{
+	struct hal_srng *tcl_ring;
+	unsigned long ring;
+
+	for_each_set_bit(ring, &ab->dp.xdp_tx_pending,
+			 ab->hw_params.hal_params->num_tx_rings) {
+		tcl_ring = &ab->hal.srng_list[ab->dp.tx_ring[ring].tcl_data_ring.ring_id];
+		spin_lock_bh(&tcl_ring->lock);
+		if (test_and_clear_bit(ring, &ab->dp.xdp_tx_pending))
+			ath11k_dp_tx_xdp_ring_end(ab, ring);
+		spin_unlock_bh(&tcl_ring->lock);
+	}
+}
+
+/* The station a run of frames goes to, looked up once per destination. */
+struct ath11k_dp_tx_xdp_dst {
+	u8 addr[ETH_ALEN];
+	struct ieee80211_sta *sta;
+};
+
+static struct ieee80211_sta *
+ath11k_dp_tx_xdp_sta(struct ieee80211_vif *vif, const u8 *addr,
+		     struct ath11k_dp_tx_xdp_dst *dst)
+{
+	struct ath11k_sta *arsta;
+
+	if (dst->sta && ether_addr_equal(addr, dst->addr))
+		return dst->sta;
+
+	dst->sta = ieee80211_find_sta(vif, addr);
+	if (!dst->sta)
+		return NULL;
+
+	arsta = ath11k_sta_to_arsta(dst->sta);
+	if (!READ_ONCE(arsta->page_tx) || arsta->use_4addr_set) {
+		dst->sta = NULL;
+		return NULL;
+	}
+	ether_addr_copy(dst->addr, addr);
+
+	return dst->sta;
+}
+
+/* Frames another device redirected to an AP interface in Ethernet
+ * encapsulation, with mac80211's TXQs off. The hardware adds the 802.11
+ * header and finds the station from the destination address.
+ *
+ * Frames the radio would treat differently from mac80211 stay with the
+ * caller: multicast, non-IP and fragmented frames, and frames to stations
+ * that are not authorized or use TKIP or 4-address mode. The TCL rings are
+ * taken once for a run of frames on the same ring, and their head pointers
+ * are written on XDP_XMIT_FLUSH.
+ */
+int ath11k_dp_tx_xdp(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+		     int n, struct xdp_frame **frames, u32 flags)
+{
+	struct ath11k_vif *arvif = ath11k_vif_to_arvif(vif);
+	struct net_device *dev = ieee80211_vif_to_wdev(vif)->netdev;
+	struct ath11k_dp_tx_xdp_dst dst = {};
+	struct ath11k *ar = arvif->ar;
+	struct ath11k_base *ab = ar->ab;
+	struct dp_tx_ring *tx_ring = NULL;
+	struct hal_srng *tcl_ring = NULL;
+	unsigned int bytes = 0;
+	int ring = -1, i, id;
+
+	if (unlikely(!(vif->offload_flags & IEEE80211_OFFLOAD_ENCAP_ENABLED) ||
+		     test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags)))
+		return 0;
+
+	for (i = 0; i < n; i++) {
+		struct xdp_frame *xdpf = frames[i];
+		const struct ethhdr *eth = xdpf->data;
+		struct hal_tx_info ti = {};
+		struct ieee80211_sta *sta;
+		void *hal_tcl_desc;
+		dma_addr_t dma;
+		u8 dsfield, ac;
+
+		if (unlikely(xdpf->len < ETH_HLEN + sizeof(struct ipv6hdr) ||
+			     xdp_frame_has_frags(xdpf) ||
+			     is_multicast_ether_addr(eth->h_dest)))
+			break;
+
+		switch (eth->h_proto) {
+		case htons(ETH_P_IP):
+			dsfield = ipv4_get_dsfield((const void *)(eth + 1));
+			break;
+		case htons(ETH_P_IPV6):
+			dsfield = ipv6_get_dsfield((const void *)(eth + 1));
+			break;
+		default:
+			goto out;
+		}
+
+		sta = ath11k_dp_tx_xdp_sta(vif, eth->h_dest, &dst);
+		if (unlikely(!sta))
+			break;
+
+		ti.tid = ieee80211_dscp_to_tid(vif, sta, dsfield);
+		ac = ath11k_dp_tx_tid_to_ac(ti.tid);
+		ti.ring_id = ab->hw_params.hw_ops->get_ring_selector(ac) %
+			     ab->hw_params.hal_params->num_tx_rings;
+
+		if (ti.ring_id != ring) {
+			if (tcl_ring) {
+				spin_unlock(&tx_ring->tx_idr_lock);
+				if (flags & XDP_XMIT_FLUSH)
+					ath11k_dp_tx_xdp_ring_end(ab, ring);
+				else
+					set_bit(ring, &ab->dp.xdp_tx_pending);
+				spin_unlock_bh(&tcl_ring->lock);
+			}
+			ring = ti.ring_id;
+			tx_ring = &ab->dp.tx_ring[ring];
+			tcl_ring = &ab->hal.srng_list[tx_ring->tcl_data_ring.ring_id];
+			spin_lock_bh(&tcl_ring->lock);
+			spin_lock(&tx_ring->tx_idr_lock);
+			clear_bit(ring, &ab->dp.xdp_tx_pending);
+			ath11k_hal_srng_access_begin(ab, tcl_ring);
+		}
+
+		/* The producer may have written the headers, so the frame is
+		 * cleaned to memory as any redirected frame is.
+		 */
+		dma = dma_map_single(ab->dev, xdpf->data, xdpf->len,
+				     DMA_TO_DEVICE);
+		if (unlikely(dma_mapping_error(ab->dev, dma)))
+			break;
+		if (unlikely(upper_32_bits(dma)))
+			goto unmap;
+
+		id = ath11k_dp_tx_buf_get_id(tx_ring,
+					     (void *)((unsigned long)xdpf |
+						      ATH11K_DP_TX_BUF_XDP));
+		if (unlikely(id < 0))
+			goto unmap;
+
+		hal_tcl_desc = ath11k_hal_srng_src_get_next_entry(ab, tcl_ring);
+		if (unlikely(!hal_tcl_desc)) {
+			ath11k_hal_srng_access_begin(ab, tcl_ring);
+			hal_tcl_desc = ath11k_hal_srng_src_get_next_entry(ab,
+									  tcl_ring);
+		}
+		if (unlikely(!hal_tcl_desc)) {
+			ab->soc_stats.tx_err.desc_na[ring]++;
+			ath11k_dp_tx_buf_put_id(tx_ring, id);
+			goto unmap;
+		}
+		tx_ring->page_dma[id] = dma;
+
+		ti.desc_id = FIELD_PREP(DP_TX_DESC_ID_MAC_ID, ar->pdev_idx) |
+			     FIELD_PREP(DP_TX_DESC_ID_MSDU_ID, id) |
+			     FIELD_PREP(DP_TX_DESC_ID_POOL_ID, ac);
+		ti.rbm_id = ab->hw_params.hal_params->tcl2wbm_rbm_map[ring].rbm_id;
+		ti.encap_type = HAL_TCL_ENCAP_TYPE_ETHERNET;
+		ti.meta_data_flags = arvif->tcl_metadata;
+		ti.addr_search_flags = arvif->hal_addr_search_flags;
+		ti.search_type = arvif->search_type;
+		ti.type = HAL_TCL_DESC_TYPE_BUFFER;
+		ti.lmac_id = ar->lmac_id;
+		ti.bss_ast_hash = arvif->ast_hash;
+		ti.bss_ast_idx = arvif->ast_idx;
+		ti.flags1 = FIELD_PREP(HAL_TCL_DATA_CMD_INFO2_TID_OVERWRITE, 1);
+		ti.paddr = dma;
+		ti.data_len = xdpf->len;
+		ath11k_hal_tx_cmd_desc_setup(ab, hal_tcl_desc +
+					     sizeof(struct hal_tlv_hdr), &ti);
+		bytes += xdpf->len;
+		continue;
+
+unmap:
+		dma_unmap_single(ab->dev, dma, xdpf->len, DMA_TO_DEVICE);
+		break;
+	}
+out:
+	if (tcl_ring) {
+		spin_unlock(&tx_ring->tx_idr_lock);
+		if (flags & XDP_XMIT_FLUSH)
+			ath11k_dp_tx_xdp_ring_end(ab, ring);
+		else
+			set_bit(ring, &ab->dp.xdp_tx_pending);
+		spin_unlock_bh(&tcl_ring->lock);
+	}
+
+	/* A flush covers rings an earlier call left open. */
+	if (flags & XDP_XMIT_FLUSH && READ_ONCE(ab->dp.xdp_tx_pending))
+		ath11k_dp_tx_xdp_flush(ab);
+
+	if (i) {
+		atomic_add(i, &ar->dp.num_tx_pending);
+		dev_sw_netstats_tx_add(dev, i, bytes);
+	}
+
+	return i;
+}
