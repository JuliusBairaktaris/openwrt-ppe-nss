diff --git a/nat46/modules/nat46-netdev.c b/nat46/modules/nat46-netdev.c
index a5a0797..c8bd5a6 100644
--- a/nat46/modules/nat46-netdev.c
+++ b/nat46/modules/nat46-netdev.c
@@ -96,6 +96,37 @@ void *netdev_nat46_instance(struct net_device *dev) {
 	return priv->nat46;
 }
 
+/*
+ * For an offload engine that mirrors the translation in hardware: copy up to
+ * @max of @dev's rule pairs into @pairs, @pair_size bytes each, which must be
+ * the size of nat46_xlate_rulepair_t. Returns how many pairs the device has,
+ * which may be more than were copied, -ENODEV for a device that is not a
+ * nat46 device and -EPROTO for a caller built against another layout. May
+ * sleep.
+ */
+int nat46_get_rules(struct net_device *dev, void *pairs, size_t pair_size, int max) {
+	nat46_instance_t *nat46;
+	int n;
+
+	if (dev->netdev_ops != &nat46_netdev_ops)
+		return -ENODEV;
+	if (pair_size != sizeof(nat46_xlate_rulepair_t))
+		return -EPROTO;
+
+	nat46 = get_nat46_instance_dev(dev);
+	if (!nat46)
+		return -ENODEV;
+	n = nat46->npairs;
+	if (max > n)
+		max = n;
+	if (max > 0)
+		memcpy(pairs, nat46->pairs, max * sizeof(nat46_xlate_rulepair_t));
+	release_nat46_instance(nat46);
+
+	return n;
+}
+EXPORT_SYMBOL_GPL(nat46_get_rules);
