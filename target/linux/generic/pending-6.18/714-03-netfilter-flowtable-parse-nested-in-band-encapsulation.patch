From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Sat, 24 Oct 2026 23:17:21 +0200
Subject: [PATCH] netfilter: flowtable: parse nested in-band encapsulation

The receive path parses the hwaccel tag and at most one in-band VLAN
or PPPoE header, and reads both relative to the MAC header. A second
in-band header, such as PPPoE behind the inner tag of a QinQ link, is
not reached, and nf_flow_encap_pop() reads the PPP protocol at a fixed
offset from the MAC header that is only right when PPPoE directly
follows it.

Add nf_flow_encap_next(), which parses one VLAN or PPPoE header at an
offset from the network header, and walk the headers with it up to
NF_FLOW_TABLE_ENCAP_MAX in the inet hook and in
nf_flow_skb_encap_protocol(). The latter records each header in the
context, from which nf_flow_tuple_encap() fills the lookup tuple.
nf_flow_encap_pop() reads the PPP protocol behind the PPPoE header it
pops. No new encapsulation fits yet, as NF_FLOW_TABLE_ENCAP_MAX is
still 2.

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
---
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -3,6 +3,7 @@
 
 #include <linux/in.h>
 #include <linux/in6.h>
+#include <linux/if_vlan.h>
 #include <linux/netdevice.h>
 #include <linux/rhashtable-types.h>
 #include <linux/rcupdate.h>
@@ -366,12 +367,11 @@ int nf_flow_rule_route_ipv6(struct net *
 int nf_flow_table_offload_init(void);
 void nf_flow_table_offload_exit(void);
 
-static inline __be16 __nf_flow_pppoe_proto(const struct sk_buff *skb)
+static inline __be16 __nf_flow_pppoe_proto(const struct pppoe_hdr *phdr)
 {
 	__be16 proto;
 
-	proto = *((__be16 *)(skb_mac_header(skb) + ETH_HLEN +
-			     sizeof(struct pppoe_hdr)));
+	proto = *((__be16 *)(phdr + 1));
 	switch (proto) {
 	case htons(PPP_IP):
 		return htons(ETH_P_IP);
@@ -387,11 +387,51 @@ static inline bool nf_flow_pppoe_proto(s
 	if (!pskb_may_pull(skb, ETH_HLEN + PPPOE_SES_HLEN))
 		return false;
 
-	*inner_proto = __nf_flow_pppoe_proto(skb);
+	*inner_proto = __nf_flow_pppoe_proto((struct pppoe_hdr *)
+					     (skb_mac_header(skb) + ETH_HLEN));
 
 	return true;
 }
 
+/**
+ * nf_flow_encap_next - parse one in-band VLAN or PPPoE header
+ * @skb: packet whose network header points at the first in-band header
+ * @proto: ethertype of the header at @offset
+ * @offset: offset of the header from the network header, advanced past it
+ * @id: VLAN ID or PPPoE session ID found in the header
+ *
+ * Return: the ethertype that follows the header, or 0 if @proto is no
+ * VLAN or PPPoE session ethertype or the header cannot be pulled.
+ */
+static inline __be16 nf_flow_encap_next(struct sk_buff *skb, __be16 proto,
+					u32 *offset, u16 *id)
+{
+	const struct pppoe_hdr *phdr;
+	const struct vlan_hdr *vhdr;
+
+	switch (proto) {
+	case htons(ETH_P_8021Q):
+	case htons(ETH_P_8021AD):
+		if (!pskb_may_pull(skb, *offset + VLAN_HLEN))
+			return 0;
+
+		vhdr = (struct vlan_hdr *)(skb_network_header(skb) + *offset);
+		*id = ntohs(vhdr->h_vlan_TCI) & VLAN_VID_MASK;
+		*offset += VLAN_HLEN;
+		return vhdr->h_vlan_encapsulated_proto;
+	case htons(ETH_P_PPP_SES):
+		if (!pskb_may_pull(skb, *offset + PPPOE_SES_HLEN))
+			return 0;
+
+		phdr = (struct pppoe_hdr *)(skb_network_header(skb) + *offset);
+		*id = ntohs(phdr->sid);
+		*offset += PPPOE_SES_HLEN;
+		return __nf_flow_pppoe_proto(phdr);
+	}
+
+	return 0;
+}
+
 #define NF_FLOW_TABLE_STAT_INC(net, count) __this_cpu_inc((net)->ft.stat->count)
 #define NF_FLOW_TABLE_STAT_DEC(net, count) __this_cpu_dec((net)->ft.stat->count)
 #define NF_FLOW_TABLE_STAT_INC_ATOMIC(net, count)	\
--- a/net/netfilter/nf_flow_table_inet.c
+++ b/net/netfilter/nf_flow_table_inet.c
@@ -12,25 +12,16 @@ static unsigned int
 nf_flow_offload_inet_hook(void *priv, struct sk_buff *skb,
 			  const struct nf_hook_state *state)
 {
-	struct vlan_ethhdr *veth;
-	__be16 proto;
+	__be16 proto = skb->protocol;
+	u32 offset = 0;
+	int i;
+	u16 id;
 
-	switch (skb->protocol) {
-	case htons(ETH_P_8021Q):
-	case htons(ETH_P_8021AD):
-		if (!pskb_may_pull(skb, skb_mac_offset(skb) + sizeof(*veth)))
-			return NF_ACCEPT;
+	for (i = skb_vlan_tag_present(skb); i < NF_FLOW_TABLE_ENCAP_MAX; i++) {
+		if (proto == htons(ETH_P_IP) || proto == htons(ETH_P_IPV6))
+			break;
 
-		veth = (struct vlan_ethhdr *)skb_mac_header(skb);
-		proto = veth->h_vlan_encapsulated_proto;
-		break;
-	case htons(ETH_P_PPP_SES):
-		if (!nf_flow_pppoe_proto(skb, &proto))
-			return NF_ACCEPT;
-		break;
-	default:
-		proto = skb->protocol;
-		break;
+		proto = nf_flow_encap_next(skb, proto, &offset, &id);
 	}
 
 	switch (proto) {
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -142,39 +142,28 @@ static bool ip_has_options(unsigned int
 	return thoff != sizeof(struct iphdr);
 }
 
-static void nf_flow_tuple_encap(struct sk_buff *skb,
-				struct flow_offload_tuple *tuple)
-{
-	struct vlan_ethhdr *veth;
-	struct pppoe_hdr *phdr;
-	int i = 0;
-
-	if (skb_vlan_tag_present(skb)) {
-		tuple->encap[i].id = skb_vlan_tag_get_id(skb);
-		tuple->encap[i].proto = skb->vlan_proto;
-		i++;
-	}
-	switch (skb->protocol) {
-	case htons(ETH_P_8021Q):
-	case htons(ETH_P_8021AD):
-		veth = (struct vlan_ethhdr *)skb_mac_header(skb);
-		tuple->encap[i].id = ntohs(veth->h_vlan_TCI) & VLAN_VID_MASK;
-		tuple->encap[i].proto = skb->protocol;
-		break;
-	case htons(ETH_P_PPP_SES):
-		phdr = (struct pppoe_hdr *)skb_network_header(skb);
-		tuple->encap[i].id = ntohs(phdr->sid);
-		tuple->encap[i].proto = skb->protocol;
-		break;
-	}
-}
-
 struct nf_flowtable_ctx {
 	const struct net_device	*in;
 	u32			offset;
 	u32			hdrsize;
+	struct {
+		u16		id;
+		__be16		proto;
+	} encap[NF_FLOW_TABLE_ENCAP_MAX];
+	u8			encap_num;
 };
 
+static void nf_flow_tuple_encap(struct nf_flowtable_ctx *ctx,
+				struct flow_offload_tuple *tuple)
+{
+	int i;
+
+	for (i = 0; i < ctx->encap_num; i++) {
+		tuple->encap[i].id = ctx->encap[i].id;
+		tuple->encap[i].proto = ctx->encap[i].proto;
+	}
+}
+
 static int nf_flow_tuple_ip(struct nf_flowtable_ctx *ctx, struct sk_buff *skb,
 			    struct flow_offload_tuple *tuple)
 {
@@ -242,7 +231,7 @@ static int nf_flow_tuple_ip(struct nf_fl
 	tuple->l3proto		= AF_INET;
 	tuple->l4proto		= ipproto;
 	tuple->iifidx		= ctx->in->ifindex;
-	nf_flow_tuple_encap(skb, tuple);
+	nf_flow_tuple_encap(ctx, tuple);
 
 	return 0;
 }
@@ -279,34 +268,31 @@ static unsigned int nf_flow_xmit_xfrm(st
 	return NF_STOLEN;
 }
 
-static bool nf_flow_skb_encap_protocol(struct sk_buff *skb, __be16 proto,
-				       u32 *offset)
+static bool nf_flow_skb_encap_protocol(struct nf_flowtable_ctx *ctx,
+				       struct sk_buff *skb, __be16 proto)
 {
-	struct vlan_ethhdr *veth;
-	__be16 inner_proto;
+	__be16 inner_proto = skb->protocol;
+
+	if (skb_vlan_tag_present(skb)) {
+		ctx->encap[0].id = skb_vlan_tag_get_id(skb);
+		ctx->encap[0].proto = skb->vlan_proto;
+		ctx->encap_num = 1;
+	}
 
-	switch (skb->protocol) {
-	case htons(ETH_P_8021Q):
-	case htons(ETH_P_8021AD):
-		if (!pskb_may_pull(skb, skb_mac_offset(skb) + sizeof(*veth)))
+	while (inner_proto != proto) {
+		if (ctx->encap_num == NF_FLOW_TABLE_ENCAP_MAX)
 			return false;
 
-		veth = (struct vlan_ethhdr *)skb_mac_header(skb);
-		if (veth->h_vlan_encapsulated_proto == proto) {
-			*offset += VLAN_HLEN;
-			return true;
-		}
-		break;
-	case htons(ETH_P_PPP_SES):
-		if (nf_flow_pppoe_proto(skb, &inner_proto) &&
-		    inner_proto == proto) {
-			*offset += PPPOE_SES_HLEN;
-			return true;
-		}
-		break;
+		ctx->encap[ctx->encap_num].proto = inner_proto;
+		inner_proto = nf_flow_encap_next(skb, inner_proto, &ctx->offset,
+						 &ctx->encap[ctx->encap_num].id);
+		if (!inner_proto)
+			return false;
+
+		ctx->encap_num++;
 	}
 
-	return false;
+	return true;
 }
 
 static void nf_flow_encap_pop(struct sk_buff *skb,
@@ -329,7 +315,8 @@ static void nf_flow_encap_pop(struct sk_
 			skb_reset_network_header(skb);
 			break;
 		case htons(ETH_P_PPP_SES):
-			skb->protocol = __nf_flow_pppoe_proto(skb);
+			skb->protocol = __nf_flow_pppoe_proto((struct pppoe_hdr *)
+							      skb->data);
 			skb_pull(skb, PPPOE_SES_HLEN);
 			skb_reset_network_header(skb);
 			break;
@@ -369,8 +356,7 @@ nf_flow_offload_lookup(struct nf_flowtab
 {
 	struct flow_offload_tuple tuple = {};
 
-	if (skb->protocol != htons(ETH_P_IP) &&
-	    !nf_flow_skb_encap_protocol(skb, htons(ETH_P_IP), &ctx->offset))
+	if (!nf_flow_skb_encap_protocol(ctx, skb, htons(ETH_P_IP)))
 		return NULL;
 
 	if (nf_flow_tuple_ip(ctx, skb, &tuple) < 0)
@@ -669,7 +655,7 @@ static int nf_flow_tuple_ipv6(struct nf_
 	tuple->l3proto		= AF_INET6;
 	tuple->l4proto		= nexthdr;
 	tuple->iifidx		= ctx->in->ifindex;
-	nf_flow_tuple_encap(skb, tuple);
+	nf_flow_tuple_encap(ctx, tuple);
 
 	return 0;
 }
@@ -730,8 +716,7 @@ nf_flow_offload_ipv6_lookup(struct nf_fl
 {
 	struct flow_offload_tuple tuple = {};
 
-	if (skb->protocol != htons(ETH_P_IPV6) &&
-	    !nf_flow_skb_encap_protocol(skb, htons(ETH_P_IPV6), &ctx->offset))
+	if (!nf_flow_skb_encap_protocol(ctx, skb, htons(ETH_P_IPV6)))
 		return NULL;
 
 	if (nf_flow_tuple_ipv6(ctx, skb, &tuple) < 0)
